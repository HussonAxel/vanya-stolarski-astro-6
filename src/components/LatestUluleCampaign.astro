---
import { Image } from "astro:assets";
import { getImageDimensions } from "../lib/image-dimensions";
import { getUluleCampaignCard } from "../lib/ulule";

const campaign = await getUluleCampaignCard();
const isLocalCampaignCover = campaign.coverSrc.startsWith("/");
const campaignCoverDimensions = getImageDimensions(campaign.coverSrc);
---

<div
    class="campaign-card hero-card group relative h-full min-h-[22rem] overflow-hidden rounded-lg bg-[#3a4d45] p-6 sm:p-7 md:p-8 lg:p-9 xl:min-h-0"
>
    <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.12),transparent_34%),radial-gradient(circle_at_bottom_left,rgba(255,255,255,0.07),transparent_30%)]"
    >
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/10">
    </div>
    <div
        class="pointer-events-none absolute right-[-8%] bottom-[-22%] h-64 w-64 rounded-full bg-[#d8e6df]/10 blur-3xl transition-transform duration-700 group-hover:scale-110"
    >
    </div>

    <div
        class="campaign-layout relative z-10 grid h-full gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(220px,280px)] lg:items-center"
    >
        <div class="campaign-content flex flex-col gap-5">
            <div class="campaign-head flex flex-col gap-4">
                <div class="campaign-brand flex flex-wrap items-center justify-between gap-3">
                    <a
                        href={campaign.primaryHref}
                        target={campaign.primaryHref.startsWith("http")
                            ? "_blank"
                            : undefined}
                        rel={campaign.primaryHref.startsWith("http")
                            ? "noreferrer"
                            : undefined}
                        aria-label="Voir la campagne sur Ulule"
                        class="hero-chip-link inline-flex h-11 items-center rounded-lg border border-white/10 bg-white/10 px-2.5 hover:bg-white/15"
                    >
                        <Image
                            src="/assets/logo/ulule-horizontal-white.svg"
                            alt="Ulule"
                            width="100"
                            height="31"
                            loading="eager"
                            class="h-auto w-[6.25rem]"
                        />
                    </a>
                </div>

                <div class="campaign-copy flex flex-col gap-3">
                    <h3
                        class="max-w-xl font-serif text-4xl leading-none text-white text-balance md:text-[3rem] lg:text-[3.35rem]"
                    >
                        {campaign.title}
                    </h3>
                    <p
                        class="max-w-2xl font-sans text-sm leading-relaxed text-white/70"
                    >
                        {campaign.subtitle}
                    </p>
                    <p
                        class="campaign-description max-w-2xl font-sans text-sm leading-relaxed text-white/45"
                    >
                        {campaign.description}
                    </p>
                </div>
            </div>

            <div class="campaign-stats grid grid-cols-3 gap-2 sm:gap-3">
                {
                    campaign.stats.map((stat) => (
                        <div class="campaign-stat rounded-lg border border-white/10 bg-white/[0.07] px-3 py-3.5 transition-colors duration-300 group-hover:bg-white/[0.1] sm:px-4 sm:py-4">
                            <p class="font-serif text-xl leading-none text-white sm:text-[1.55rem]">
                                {stat.value}
                            </p>
                            <p class="mt-2 font-sans text-[8px] font-semibold tracking-[0.18em] text-white/55 uppercase">
                                {stat.label}
                            </p>
                        </div>
                    ))
                }
            </div>

            <div class="campaign-actions flex flex-wrap gap-2">
                <a
                    href={campaign.primaryHref}
                    target={campaign.primaryHref.startsWith("http")
                        ? "_blank"
                        : undefined}
                    rel={campaign.primaryHref.startsWith("http")
                        ? "noreferrer"
                        : undefined}
                    class="hero-chip-link inline-flex h-10 items-center rounded-full bg-white px-4 font-sans text-[8px] font-semibold tracking-[0.18em] text-[#31433c] uppercase hover:bg-[#edf4f0] sm:px-5 sm:text-[9px] sm:tracking-[0.22em]"
                >
                    {campaign.primaryLabel}
                </a>
                {
                    campaign.secondaryHref && campaign.secondaryLabel && (
                        <a
                            href={campaign.secondaryHref}
                            class="hero-chip-link inline-flex h-10 items-center rounded-full border border-white/16 bg-transparent px-4 font-sans text-[8px] font-semibold tracking-[0.18em] text-white uppercase hover:border-white/30 hover:bg-white hover:text-[#31433c] sm:px-5 sm:text-[9px] sm:tracking-[0.22em]"
                        >
                            {campaign.secondaryLabel}
                        </a>
                    )
                }
            </div>
        </div>

        <div class="campaign-media relative flex flex-col items-center gap-3 lg:gap-4">
            <div
                class="pointer-events-none absolute inset-x-[14%] bottom-2 h-8 rounded-full bg-[#18201d]/30 blur-2xl"
            >
            </div>
            <div
                class="pointer-events-none absolute left-1/2 top-8 h-40 w-40 -translate-x-1/2 rounded-full bg-white/10 blur-3xl"
            >
            </div>

            <div class="relative z-10 flex w-full justify-center">
                <div
                    class="campaign-frame w-full max-w-[14rem] rounded-lg border border-white/10 bg-white/[0.06] p-3.5 sm:p-4 lg:max-w-[16rem] xl:max-w-[14rem] 2xl:max-w-[17rem]"
                >
                    <div
                        class="campaign-cover-stage flex aspect-[4/5] items-center justify-center rounded-lg bg-[linear-gradient(180deg,#f7f1ec_0%,#ebe2dc_100%)] p-4 shadow-[0_34px_100px_-46px_rgba(0,0,0,0.58)] transition-all duration-700 group-hover:shadow-[0_42px_120px_-50px_rgba(0,0,0,0.62)]"
                    >
                        {
                            isLocalCampaignCover ? (
                                <Image
                                    src={campaign.coverSrc}
                                    alt={campaign.coverAlt}
                                    width={campaignCoverDimensions.width}
                                    height={campaignCoverDimensions.height}
                                    class="h-full w-auto max-w-full object-contain drop-shadow-[0_20px_30px_rgba(61,56,52,0.2)]"
                                    loading="lazy"
                                />
                            ) : (
                                <img
                                    src={campaign.coverSrc}
                                    alt={campaign.coverAlt}
                                    class="h-full w-auto max-w-full object-contain drop-shadow-[0_20px_30px_rgba(61,56,52,0.2)]"
                                    loading="lazy"
                                />
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-card {
        transition:
            transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 400ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-chip-link {
        transition:
            background-color 300ms cubic-bezier(0.16, 1, 0.3, 1),
            color 300ms cubic-bezier(0.16, 1, 0.3, 1),
            border-color 300ms cubic-bezier(0.16, 1, 0.3, 1),
            transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media (min-width: 1280px) and (max-height: 1000px) {
        .campaign-card {
            padding: 1.5rem;
        }

        .campaign-layout {
            grid-template-columns: minmax(0, 1fr) minmax(180px, 220px);
            gap: 1.25rem;
        }

        .campaign-content {
            gap: 0.75rem;
        }

        .campaign-head,
        .campaign-copy {
            gap: 0.5rem;
        }

        .campaign-copy h3 {
            font-size: 2.35rem;
        }

        .campaign-description {
            display: none;
        }

        .campaign-stats {
            gap: 0.5rem;
        }

        .campaign-stat {
            border-radius: 0.875rem;
            padding: 0.625rem 0.75rem;
        }

        .campaign-stat p:first-child {
            font-size: 1.125rem;
        }

        .campaign-stat p:last-child {
            margin-top: 0.375rem;
            font-size: 0.4375rem;
        }

        .campaign-actions a {
            height: 2.25rem;
        }

        .campaign-media {
            gap: 0.5rem;
        }

        .campaign-frame {
            max-width: 12rem;
            padding: 0.625rem;
        }

        .campaign-cover-stage {
            padding: 0.75rem;
        }
    }

    @media (min-width: 1280px) and (max-height: 760px) {
        .campaign-brand a {
            height: 2.25rem;
        }

        .campaign-brand img {
            width: 5.625rem;
        }

        .campaign-copy p {
            display: none;
        }

        .campaign-stats {
            min-height: 3rem;
        }

        .campaign-stat {
            padding: 0.5rem 0.625rem;
        }

        .campaign-actions a {
            height: 2rem;
        }

        .campaign-frame {
            max-width: 8.75rem;
            padding: 0.5rem;
        }

        .campaign-cover-stage {
            padding: 0.5rem;
        }
    }

    @media (hover: hover) {
        .hero-card:hover {
            box-shadow: 0 32px 80px -40px rgba(11, 18, 15, 0.45);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-card,
        .hero-chip-link {
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
            transform: none !important;
        }
    }
</style>
