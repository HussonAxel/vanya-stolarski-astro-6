---
import { Image } from "astro:assets";
import "../styles/global.css";
import { getImageDimensions } from "../lib/image-dimensions";

type Cover = {
  id: string;
  title: string;
  edition: string;
  src: string;
  profile?: string;
  effect?: string;
};

const covers: Cover[] = [
  
  {
    id: "aube-musique",
    title: "Aube · Variation musicale",
    edition: "Filtre Holographique",
    src: "/assets/card-tests/collibris/aube-musique.webp",
    effect: "holo",
  },
  {
    id: "aube-couverture",
    title: "Aube · Première couverture",
    edition: "Filtre Satin",
    src: "/assets/card-tests/collibris/aube-premiere-couverture.webp",
    effect: "satin",
  },
  {
    id: "pumpkin-space",
    title: "Pumpkin Space",
    edition: "Filtre Prismatique",
    src: "/assets/card-tests/collibris/pumpkin-space.webp",
    effect: "prism",
  },
  {
    id: "phenix-003",
    title: "Le Phénix d’espoir",
    edition: "Filtre Projecteur",
    src: "/assets/card-tests/collibris/phenix-003.webp",
    effect: "spot",
  },
  {
    id: "coeur-renard-mockup",
    title: "Cœur de Renard · Renard et Fortune",
    edition: "Filtre Holographique",
    src: "/assets/card-tests/collibris/coeur-de-renard-mockup-2.webp",
    effect: "holo",
  },
  {
    id: "pokebox-199",
    title: "Charizard ex #199",
    edition: "Référence Pokebox · SIR",
    src: "/assets/card-tests/pokebox-sv3-5-199/front.webp",
    profile: "pokebox-sir",
  },
];

const effects = [
  { id: "satin", label: "Satin", description: "Lumière douce" },
  { id: "holo", label: "Holographique", description: "Foil irisé" },
  { id: "prism", label: "Prismatique", description: "Spectre net" },
  { id: "spot", label: "Projecteur", description: "Reflet ciblé" },
  { id: "beui-mesh", label: "Mesh", description: "beUI · Gradient fluide" },
  { id: "beui-mesh-aurora", label: "Mesh — Aurora", description: "beUI · Vert & ultraviolet" },
  { id: "beui-warp", label: "Warp", description: "beUI · Rubans fluides" },
  { id: "beui-voronoi", label: "Voronoï", description: "beUI · Cristaux mobiles" },
  { id: "beui-orbit", label: "Dot Orbit", description: "beUI · Micro-reflets orbitaux" },
  { id: "beui-rays", label: "God Rays", description: "beUI · Rayons polaires" },
  { id: "pokebox-ir", label: "Pokebox IR", description: "Illustration Rare · carte #168" },
  { id: "pokebox-sir", label: "Pokebox SIR", description: "Effet SIR original" },
];

const materialLayers = [
  { id: "silver", label: "Base argentée", description: "Éclaircit les zones du masque", uniform: "uLayerSilver", value: 100 },
  { id: "shine", label: "Reflet spectral", description: "Bandes irisées diagonales", uniform: "uLayerShine", value: 100 },
  { id: "wash", label: "Voile irisé", description: "Couleur douce liée à l’inclinaison", uniform: "uLayerWash", value: 100 },
  { id: "glitter", label: "Paillettes", description: "Trois textures réactives au regard", uniform: "uLayerGlitter", value: 100 },
  { id: "glare", label: "Halo", description: "Point lumineux qui suit le pointeur", uniform: "uLayerGlare", value: 100 },
  { id: "etch", label: "Relief gravé", description: "Éclats guidés par les contours", uniform: "uLayerEtch", value: 100 },
];

const materialControls = [
  { group: "Image", label: "Luminosité de base", uniform: "uSirBaseBrightness", min: 0.7, max: 1.3, step: 0.01, value: 1 },
  { group: "Image", label: "Contraste de base", uniform: "uSirBaseContrast", min: 0.65, max: 1.5, step: 0.01, value: 1 },
  { group: "Reflet", label: "Angle", uniform: "uSirShineAngle", min: 0, max: 360, step: 1, value: 90, suffix: "°" },
  { group: "Reflet", label: "Fréquence", uniform: "uSirShineFrequency", min: 0.25, max: 6, step: 0.05, value: 1 },
  { group: "Reflet", label: "Luminosité", uniform: "uSirShineBrightness", min: -0.3, max: 0.3, step: 0.01, value: 0 },
  { group: "Reflet", label: "Contraste", uniform: "uSirShineContrast", min: 0.5, max: 2.5, step: 0.05, value: 1 },
  { group: "Reflet", label: "Saturation", uniform: "uSirShineSaturation", min: 0, max: 5, step: 0.05, value: 3.25 },
  { group: "Voile", label: "Échelle", uniform: "uSirWashScale", min: 0.2, max: 4, step: 0.05, value: 1.1 },
  { group: "Voile", label: "Réponse à l’inclinaison", uniform: "uSirWashTiltSensitivity", min: 0, max: 6, step: 0.05, value: 2.3 },
  { group: "Voile", label: "Saturation", uniform: "uSirWashSaturation", min: 0, max: 3, step: 0.05, value: 0.8 },
  { group: "Voile", label: "Contraste", uniform: "uSirWashContrast", min: 0.4, max: 1.8, step: 0.05, value: 0.95 },
  { group: "Voile", label: "Opacité", uniform: "uSirWashOpacity", min: 0, max: 1.5, step: 0.05, value: 0.75 },
  { group: "Paillettes", label: "Contraste", uniform: "uSirGlitterContrast", min: 0.5, max: 5, step: 0.05, value: 2.3 },
  { group: "Paillettes", label: "Saturation", uniform: "uSirGlitterSaturation", min: 0, max: 4, step: 0.05, value: 0 },
  { group: "Relief A", label: "Échelle", uniform: "uSirTiltSparkleScale", min: 1, max: 14, step: 0.1, value: 4.5 },
  { group: "Relief A", label: "Intensité", uniform: "uSirTiltSparkleIntensity", min: 0, max: 1.5, step: 0.05, value: 0.4 },
  { group: "Relief A", label: "Sensibilité", uniform: "uSirTiltSparkleTiltSensitivity", min: 0, max: 1, step: 0.01, value: 0.1 },
  { group: "Relief B", label: "Échelle", uniform: "uSirTiltSparkle2Scale", min: 1, max: 14, step: 0.1, value: 6 },
  { group: "Relief B", label: "Intensité", uniform: "uSirTiltSparkle2Intensity", min: 0, max: 1.5, step: 0.05, value: 0.4 },
  { group: "Relief B", label: "Sensibilité", uniform: "uSirTiltSparkle2TiltSensitivity", min: 0, max: 1, step: 0.01, value: 0.05 },
];
const positions: Array<[string, string, number, number]> = [
  ["top-left", "Haut gauche", 0.2, 0.8],
  ["top", "Haut", 0.5, 0.8],
  ["top-right", "Haut droite", 0.8, 0.8],
  ["left", "Gauche", 0.2, 0.5],
  ["center", "Centre", 0.5, 0.5],
  ["right", "Droite", 0.8, 0.5],
  ["bottom-left", "Bas gauche", 0.2, 0.2],
  ["bottom", "Bas", 0.5, 0.2],
  ["bottom-right", "Bas droite", 0.8, 0.2],
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Atelier interactif Three.js pour tester les matières et effets des cartes de Vanya Stolarski."
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=lune-3" />
    <title>Atelier cartes 3D - Vanya Stolarski</title>
  </head>
  <body class="card-lab-body">
    <main class="card-lab-shell">
      <header class="lab-header">
        <a class="brand-link" href="/livres" aria-label="Retour aux livres">
          <span class="brand-monogram">VS</span>
          <span>
            <strong>Vanya Stolarski</strong>
            <small>Atelier de cartes 3D</small>
          </span>
        </a>
        <a class="exit-link" href="/livres">
          <span aria-hidden="true">←</span>
          Retour aux livres
        </a>
      </header>

      <section class="lab-intro" aria-labelledby="lab-title">
        <p class="eyebrow">Laboratoire de matière</p>
        <h1 id="lab-title">Composez la lumière.<br />Révélez la couverture.</h1>
        <p class="intro-copy">
          Déplacez la carte, choisissez un effet et placez son point de lumière.
          Chaque réglage agit directement sur la scène Three.js.
        </p>
      </section>

      <section class="lab-workspace" aria-label="Configurateur de carte 3D">
        <div class="stage-column">
          <div class="stage" id="card-stage">
            <canvas id="card-canvas" aria-label="Aperçu interactif de la carte en trois dimensions"></canvas>

            <div class="stage-topline" aria-live="polite">
              <span>
                <strong id="stage-book-title">{covers[0].title}</strong>
                <small id="stage-book-edition">{covers[0].edition}</small>
              </span>
              <span class="render-state" id="render-state">Préparation de la matière</span>
            </div>

            <div class="stage-help">
              <span>Pointez pour incliner</span>
              <span id="stage-effect-label">Holographique</span>
            </div>

            <div class="stage-error" id="stage-error" role="alert" hidden>
              WebGL n’a pas pu démarrer. Essayez un navigateur récent ou désactivez le mode économie d’énergie.
            </div>
          </div>

          <div class="cover-switcher" aria-label="Choisir une couverture">
            {
              covers.map((cover, index) => (
                <button
                  type="button"
                  class="cover-option"
                  data-cover-src={cover.src}
                  data-cover-profile={cover.profile ?? "book"}
                  data-cover-effect={cover.effect}
                  data-cover-title={cover.title}
                  data-cover-edition={cover.edition}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <Image
                    src={cover.src}
                    alt=""
                    width={getImageDimensions(cover.src).width}
                    height={getImageDimensions(cover.src).height}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <span>
                    <strong>{cover.title}</strong>
                    <small>{cover.edition}</small>
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <aside class="control-panel" aria-label="Réglages des effets">
          <div class="panel-heading">
            <div>
              <p>Réglages</p>
              <h2>Matière active</h2>
            </div>
            <button type="button" class="reset-button" id="reset-controls">Réinitialiser</button>
          </div>

          <fieldset class="control-group">
            <legend>Effet</legend>
            <div class="effect-grid">
              {
                effects.map((effect) => (
                  <button
                    type="button"
                    class="effect-option"
                    data-effect={effect.id}
                    aria-pressed={effect.id === "holo" ? "true" : "false"}
                  >
                    <span class={`effect-swatch effect-swatch--${effect.id}`} aria-hidden="true"></span>
                    <span>
                      <strong>{effect.label}</strong>
                      <small>{effect.description}</small>
                    </span>
                  </button>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="control-group">
            <legend>Position du reflet</legend>
            <div class="position-control">
              <div class="position-grid" aria-label="Placer le point de lumière">
                {
                  positions.map(([id, label, x, y]) => (
                    <button
                      type="button"
                      class="position-option"
                      data-position={id}
                      data-x={x}
                      data-y={y}
                      aria-label={label}
                      aria-pressed={id === "center" ? "true" : "false"}
                    >
                      <span></span>
                    </button>
                  ))
                }
              </div>
              <p>
                Sélectionnez une zone fixe, ou activez le suivi pour déplacer le reflet avec le pointeur.
              </p>
            </div>
          </fieldset>

          <fieldset class="control-group slider-group">
            <legend>Propriétés</legend>

            <label class="range-control">
              <span>Intensité <output id="intensity-output">72%</output></span>
              <input id="intensity" type="range" min="0" max="100" value="72" />
            </label>

            <label class="range-control">
              <span>Inclinaison <output id="tilt-output">14°</output></span>
              <input id="tilt" type="range" min="0" max="24" value="14" />
            </label>

            <label class="range-control">
              <span>Épaisseur <output id="depth-output">18%</output></span>
              <input id="depth" type="range" min="4" max="36" value="18" />
            </label>

            <label class="range-control">
              <span>Diffusion <output id="softness-output">46%</output></span>
              <input id="softness" type="range" min="0" max="100" value="46" />
            </label>
          </fieldset>

          <fieldset class="control-group">
            <legend>Mouvement</legend>
            <div class="toggle-list">
              <label class="toggle-row">
                <span><strong>Suivi du pointeur</strong><small>Le reflet suit la surface</small></span>
                <input id="pointer-follow" type="checkbox" checked />
                <i aria-hidden="true"></i>
              </label>
              <label class="toggle-row">
                <span><strong>Flottement</strong><small>Respiration lente de la carte</small></span>
                <input id="float-motion" type="checkbox" checked />
                <i aria-hidden="true"></i>
              </label>
              <label class="toggle-row">
                <span><strong>Rotation lente</strong><small>Inspection automatique du volume</small></span>
                <input id="auto-rotate" type="checkbox" />
                <i aria-hidden="true"></i>
              </label>
              <label class="toggle-row">
                <span><strong>Ombre portée</strong><small>Ancre la carte dans la scène</small></span>
                <input id="cast-shadow" type="checkbox" checked />
                <i aria-hidden="true"></i>
              </label>
            </div>
          </fieldset>

          <div class="preset-row" aria-label="Préréglages">
            <span>Préréglages</span>
            <div>
              <button type="button" data-preset="velvet">Velours</button>
              <button type="button" data-preset="chrome">Chrome</button>
              <button type="button" data-preset="spectrum">Spectre</button>
            </div>
          </div>
        </aside>
      </section>

      <section class="material-builder" id="material-builder" aria-labelledby="builder-title">
        <header class="builder-header">
          <div>
            <p class="eyebrow">Pokebox Material Builder</p>
            <h2 id="builder-title">Construisez une matière, couche par couche.</h2>
            <p>Les réglages s’appliquent à la carte sélectionnée. L’image originale reste intacte.</p>
          </div>
          <button type="button" class="builder-primary" id="activate-builder">Activer Pokebox</button>
        </header>

        <div class="builder-grid">
          <section class="builder-pane" aria-labelledby="builder-sources-title">
            <div class="builder-pane-heading">
              <span>01</span>
              <div><h3 id="builder-sources-title">Surfaces</h3><p>Définissez où agit la matière.</p></div>
            </div>

            <label class="builder-field">
              <span>Masque holographique</span>
              <select id="material-mask-mode">
                <option value="auto">Automatique · adapté à la carte</option>
                <option value="full">Pleine surface</option>
                <option value="reference">Masque SIR de référence</option>
                <option value="uploaded">Image personnalisée</option>
                <option value="none">Aucun effet</option>
              </select>
            </label>
            <label class="file-field">
              <span>Importer un masque</span>
              <input id="material-mask-file" type="file" accept="image/png,image/jpeg,image/webp" />
              <small>PNG ou WebP en niveaux de gris, même format que la carte.</small>
            </label>

            <label class="builder-field">
              <span>Texture de gravure</span>
              <select id="material-etch-mode">
                <option value="auto">Relief automatique de la carte</option>
                <option value="reference">Gravure SIR de référence</option>
                <option value="uploaded">Image personnalisée</option>
                <option value="none">Sans relief</option>
              </select>
            </label>
            <label class="file-field">
              <span>Importer une gravure</span>
              <input id="material-etch-file" type="file" accept="image/png,image/jpeg,image/webp" />
              <small>Les contours clairs deviennent les zones en relief.</small>
            </label>

            <div class="tint-field">
              <label for="material-tint">Teinte de matière</label>
              <div>
                <input id="material-tint" type="color" value="#fff1d2" />
                <label class="range-control builder-range">
                  <span>Présence <output id="material-tint-strength-output">0%</output></span>
                  <input id="material-tint-strength" type="range" min="0" max="100" value="0" />
                </label>
              </div>
            </div>
          </section>

          <section class="builder-pane" aria-labelledby="builder-layers-title">
            <div class="builder-pane-heading">
              <span>02</span>
              <div><h3 id="builder-layers-title">Couches</h3><p>Activez et dosez chaque famille.</p></div>
            </div>
            <div class="layer-stack">
              {
                materialLayers.map((layer) => (
                  <article class="layer-control" data-layer={layer.id}>
                    <label class="layer-toggle">
                      <input type="checkbox" checked data-layer-enabled={layer.uniform} />
                      <i aria-hidden="true"></i>
                      <span><strong>{layer.label}</strong><small>{layer.description}</small></span>
                    </label>
                    <label class="range-control builder-range">
                      <span>Intensité <output data-layer-output={layer.uniform}>{layer.value}%</output></span>
                      <input type="range" min="0" max="100" value={layer.value} data-layer-uniform={layer.uniform} />
                    </label>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="builder-pane builder-pane--parameters" aria-labelledby="builder-parameters-title">
            <div class="builder-pane-heading">
              <span>03</span>
              <div><h3 id="builder-parameters-title">Paramètres fins</h3><p>Les réglages du shader SIR, sans abstraction.</p></div>
            </div>
            <div class="parameter-folds">
              {
                ["Image", "Reflet", "Voile", "Paillettes", "Relief A", "Relief B"].map((group, index) => (
                  <details class="parameter-fold" open={index === 0}>
                    <summary>{group}<span>{materialControls.filter((control) => control.group === group).length}</span></summary>
                    <div>
                      {materialControls.filter((control) => control.group === group).map((control) => (
                        <label class="range-control builder-range">
                          <span>{control.label}<output data-material-output={control.uniform}>{control.value}{control.suffix ?? ""}</output></span>
                          <input
                            type="range"
                            min={control.min}
                            max={control.max}
                            step={control.step}
                            value={control.value}
                            data-material-uniform={control.uniform}
                            data-suffix={control.suffix ?? ""}
                          />
                        </label>
                      ))}
                    </div>
                  </details>
                ))
              }
            </div>
          </section>

          <section class="builder-pane builder-pane--presets" aria-labelledby="builder-presets-title">
            <div class="builder-pane-heading">
              <span>04</span>
              <div><h3 id="builder-presets-title">Presets JSON</h3><p>Conservez, partagez et rechargez une matière.</p></div>
            </div>
            <div class="material-presets" aria-label="Presets de départ">
              <button type="button" data-material-preset="nacre">Nacre</button>
              <button type="button" data-material-preset="argent">Argent gravé</button>
              <button type="button" data-material-preset="dore">Dorure</button>
              <button type="button" data-material-preset="cosmique">Cosmique</button>
            </div>
            <label class="builder-field">
              <span>Preset enregistré</span>
              <select id="saved-material-presets"><option value="">Choisir un preset local</option></select>
            </label>
            <label class="builder-field">
              <span>Nom du preset</span>
              <input id="material-preset-name" type="text" value="Ma matière" maxlength="64" />
            </label>
            <div class="builder-actions">
              <button type="button" id="save-material-preset">Enregistrer</button>
              <button type="button" id="download-material-preset">Télécharger JSON</button>
              <label class="button-file">Importer JSON<input id="import-material-preset" type="file" accept="application/json,.json" /></label>
            </div>
            <label class="builder-field builder-json-field">
              <span>Configuration JSON</span>
              <textarea id="material-preset-json" rows="9" spellcheck="false" aria-label="Configuration JSON du matériau"></textarea>
            </label>
            <button type="button" class="builder-secondary" id="apply-material-json">Appliquer ce JSON</button>
            <p class="builder-status" id="builder-status" aria-live="polite">Le builder est prêt.</p>
          </section>
        </div>
      </section>

      <section class="comparison-panel" aria-labelledby="comparison-title">
        <header class="comparison-header">
          <div>
            <p class="eyebrow">Comparateur</p>
            <h2 id="comparison-title">Deux variantes, un même cadrage.</h2>
            <p>Réglez une matière, capturez-la dans A ou B, puis modifiez les paramètres.</p>
          </div>
          <div class="comparison-actions">
            <button type="button" data-capture-slot="a">Capturer A</button>
            <button type="button" data-capture-slot="b">Capturer B</button>
            <button type="button" id="clear-comparison">Effacer</button>
          </div>
        </header>
        <div class="comparison-grid">
          <figure class="comparison-card" data-comparison="a">
            <div class="comparison-placeholder"><span>A</span><p>Capturez votre première variante</p></div>
            <Image
              src={covers[0].src}
              alt="Variante A de la matière"
              width={getImageDimensions(covers[0].src).width}
              height={getImageDimensions(covers[0].src).height}
              decoding="async"
              hidden
            />
            <figcaption><strong>Variante A</strong><small>Aucune capture</small></figcaption>
          </figure>
          <figure class="comparison-card" data-comparison="b">
            <div class="comparison-placeholder"><span>B</span><p>Capturez votre seconde variante</p></div>
            <Image
              src={covers[0].src}
              alt="Variante B de la matière"
              width={getImageDimensions(covers[0].src).width}
              height={getImageDimensions(covers[0].src).height}
              decoding="async"
              hidden
            />
            <figcaption><strong>Variante B</strong><small>Aucune capture</small></figcaption>
          </figure>
        </div>
      </section>
    </main>

    <script>
      import * as THREE from "three";
      import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";
      import { createBookFoilMaterial, setBookFoilPointer } from "../lib/card-effects/bookFoilMaterial";
      import { createAutoFoilMask, createProceduralEffectTextures } from "../lib/card-effects/effectTextures";
      import {
        createPokeboxIllustrationRareMaterial,
        setPokeboxIllustrationRarePointer,
      } from "../lib/card-effects/pokeboxIllustrationRareMaterial";
      import {
        createPokeboxSpecialIllustrationMaterial,
        setPokeboxSpecialIllustrationPointer,
      } from "../lib/card-effects/pokeboxSpecialIllustrationMaterial";

      const canvas = document.querySelector("#card-canvas");
      const stage = document.querySelector("#card-stage");
      const renderState = document.querySelector("#render-state");
      const errorState = document.querySelector("#stage-error");

      if (!(canvas instanceof HTMLCanvasElement) || !(stage instanceof HTMLElement)) {
        throw new Error("La scène 3D est introuvable.");
      }

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let renderer: THREE.WebGLRenderer;

      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
          powerPreference: "high-performance",
        });
      } catch (error) {
        if (errorState instanceof HTMLElement) errorState.hidden = false;
        if (renderState instanceof HTMLElement) renderState.textContent = "WebGL indisponible";
        throw error;
      }

      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.08;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const scene = new THREE.Scene();
      const pmremGenerator = new THREE.PMREMGenerator(renderer);
      const roomEnvironment = new RoomEnvironment();
      const environmentRenderTarget = pmremGenerator.fromScene(roomEnvironment, 0.04);
      scene.environment = environmentRenderTarget.texture;
      roomEnvironment.dispose();
      pmremGenerator.dispose();
      const camera = new THREE.PerspectiveCamera(31, 1, 0.1, 100);
      camera.position.set(0, 0.1, 9.3);

      const cardRoot = new THREE.Group();
      const cardFloat = new THREE.Group();
      cardRoot.add(cardFloat);
      scene.add(cardRoot);

      const roundedRectShape = (width: number, height: number, radius: number) => {
        const x = -width / 2;
        const y = -height / 2;
        const shape = new THREE.Shape();
        shape.moveTo(x + radius, y);
        shape.lineTo(x + width - radius, y);
        shape.quadraticCurveTo(x + width, y, x + width, y + radius);
        shape.lineTo(x + width, y + height - radius);
        shape.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
        shape.lineTo(x + radius, y + height);
        shape.quadraticCurveTo(x, y + height, x, y + height - radius);
        shape.lineTo(x, y + radius);
        shape.quadraticCurveTo(x, y, x + radius, y);
        return shape;
      };

      const cardShape = roundedRectShape(3.04, 4.58, 0.13);
      const volumeGeometry = new THREE.ExtrudeGeometry(cardShape, {
        depth: 0.18,
        steps: 1,
        bevelEnabled: true,
        bevelThickness: 0.045,
        bevelSize: 0.045,
        bevelSegments: 5,
        curveSegments: 14,
      });
      volumeGeometry.center();

      const edgeMaterial = new THREE.MeshPhysicalMaterial({
        color: 0x191b19,
        metalness: 0.18,
        roughness: 0.34,
        clearcoat: 0.85,
        clearcoatRoughness: 0.2,
      });
      const volume = new THREE.Mesh(volumeGeometry, edgeMaterial);
      volume.castShadow = true;
      volume.receiveShadow = true;
      cardFloat.add(volume);

      const effectTextures = createProceduralEffectTextures();
      const { material: coverMaterial, uniforms: coverUniforms } = createBookFoilMaterial({
        mask: effectTextures.neutralMask,
        foil: effectTextures.foil,
        glitter: effectTextures.glitter,
      });

      const coverGeometry = new THREE.PlaneGeometry(3.03, 4.57, 1, 1);
      const coverMesh = new THREE.Mesh(coverGeometry, coverMaterial);
      coverMesh.position.z = 0.137;
      coverMesh.castShadow = true;
      cardFloat.add(coverMesh);

      const backMaterial = new THREE.MeshPhysicalMaterial({
        color: 0x20231f,
        roughness: 0.58,
        metalness: 0.04,
        clearcoat: 0.38,
      });
      const backMesh = new THREE.Mesh(coverGeometry, backMaterial);
      backMesh.position.z = -0.137;
      backMesh.rotation.y = Math.PI;
      cardFloat.add(backMesh);

      const floorMaterial = new THREE.ShadowMaterial({ color: 0x07100c, opacity: 0.27 });
      const floor = new THREE.Mesh(new THREE.PlaneGeometry(16, 12), floorMaterial);
      floor.position.set(0, -2.57, -0.5);
      floor.rotation.x = -Math.PI / 2;
      floor.receiveShadow = true;
      scene.add(floor);

      scene.add(new THREE.HemisphereLight(0xdce8df, 0x151714, 1.7));
      const keyLight = new THREE.SpotLight(0xfff5dc, 55, 20, Math.PI / 5, 0.65, 1.6);
      keyLight.position.set(3.8, 4.7, 6.5);
      keyLight.castShadow = true;
      keyLight.shadow.mapSize.set(1024, 1024);
      keyLight.shadow.bias = -0.0006;
      scene.add(keyLight);
      scene.add(keyLight.target);

      const rimLight = new THREE.DirectionalLight(0x759486, 2.4);
      rimLight.position.set(-4, 1, 2);
      scene.add(rimLight);

      const textureLoader = new THREE.TextureLoader();
      const loadedTextures = new Map<string, THREE.Texture>();
      const loadedMasks = new Map<string, THREE.Texture>();

      const loadCover = async (src: string): Promise<THREE.Texture> => {
        const cachedTexture = loadedTextures.get(src);
        if (cachedTexture) return cachedTexture;
        const texture = await textureLoader.loadAsync(src);
        texture.colorSpace = THREE.SRGBColorSpace;
        texture.anisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 8);
        texture.minFilter = THREE.LinearMipmapLinearFilter;
        texture.magFilter = THREE.LinearFilter;
        loadedTextures.set(src, texture);
        return texture;
      };

      const pokeboxReferencePaths = {
        front: "/assets/card-tests/pokebox-sv3-5-199/front.webp",
        mask: "/assets/card-tests/pokebox-sv3-5-199/mask.webp",
        foil: "/assets/card-tests/pokebox-sv3-5-199/etch.webp",
        iri1: "/assets/card-tests/pokebox-sv3-5-199/iri-1.webp",
        iri2: "/assets/card-tests/pokebox-sv3-5-199/iri-2.webp",
        iri7: "/assets/card-tests/pokebox-sv3-5-199/iri-7.webp",
        iri8: "/assets/card-tests/pokebox-sv3-5-199/iri-8.webp",
        iri9: "/assets/card-tests/pokebox-sv3-5-199/iri-9.webp",
      } as const;
      const pokeboxReferenceTextures = new Map<string, THREE.Texture>();
      const pokeboxGlitterPath = "/assets/card-tests/pokebox-common/glitter.webp";
      let pokeboxIrMaterial: THREE.ShaderMaterial | null = null;
      let pokeboxIrUniforms: ReturnType<typeof createPokeboxIllustrationRareMaterial>["uniforms"] | null = null;
      let pokeboxSirMaterial: THREE.ShaderMaterial | null = null;
      let pokeboxSirUniforms: ReturnType<typeof createPokeboxSpecialIllustrationMaterial>["uniforms"] | null = null;
      let currentCoverProfile = "book";
      let currentEffect = "holo";
      let currentCardTexture: THREE.Texture | null = null;
      let currentCardMask: THREE.Texture | null = null;
      let currentCardSrc = "/assets/card-tests/collibris/aube-musique.webp";
      let currentCardTitle = "Aube · Variation musicale";
      let uploadedMaskTexture: THREE.Texture | null = null;
      let uploadedEtchTexture: THREE.Texture | null = null;
      const emptyMask = new THREE.DataTexture(new Uint8Array([0]), 1, 1, THREE.RedFormat);
      emptyMask.needsUpdate = true;

      const loadPokeboxReferenceTexture = async (src: string, colorSpace: THREE.ColorSpace = THREE.NoColorSpace) => {
        const cachedTexture = pokeboxReferenceTextures.get(src);
        if (cachedTexture) return cachedTexture;
        const texture = await textureLoader.loadAsync(src);
        texture.colorSpace = colorSpace;
        texture.minFilter = THREE.LinearMipmapLinearFilter;
        texture.magFilter = THREE.LinearFilter;
        texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
        pokeboxReferenceTextures.set(src, texture);
        return texture;
      };

      const loadPokeboxReference = async () => {
        const [front, mask, foil, iri1, iri2, iri7, iri8, iri9] = await Promise.all([
          loadPokeboxReferenceTexture(pokeboxReferencePaths.front, THREE.SRGBColorSpace),
          loadPokeboxReferenceTexture(pokeboxReferencePaths.mask),
          loadPokeboxReferenceTexture(pokeboxReferencePaths.foil),
          loadPokeboxReferenceTexture(pokeboxReferencePaths.iri1),
          loadPokeboxReferenceTexture(pokeboxReferencePaths.iri2),
          loadPokeboxReferenceTexture(pokeboxReferencePaths.iri7),
          loadPokeboxReferenceTexture(pokeboxReferencePaths.iri8),
          loadPokeboxReferenceTexture(pokeboxReferencePaths.iri9),
        ]);

        if (!pokeboxSirMaterial || !pokeboxSirUniforms) {
          const referenceMaterial = createPokeboxSpecialIllustrationMaterial({
            mask,
            foil,
            iri1,
            iri2,
            iri7,
            iri8,
            iri9,
          });
          pokeboxSirMaterial = referenceMaterial.material;
          pokeboxSirUniforms = referenceMaterial.uniforms;
        }

        return { front, mask, foil };
      };

      const applyPokeboxIllustrationRareToCurrentCard = async () => {
        if (!currentCardTexture || !currentCardMask) {
          throw new Error("La carte active n’est pas prête.");
        }
        const glitter = await loadPokeboxReferenceTexture(pokeboxGlitterPath);
        if (!pokeboxIrMaterial || !pokeboxIrUniforms) {
          const illustrationMaterial = createPokeboxIllustrationRareMaterial({
            mask: currentCardMask,
            foil: emptyMask,
            glitter,
          });
          pokeboxIrMaterial = illustrationMaterial.material;
          pokeboxIrUniforms = illustrationMaterial.uniforms;
        }
        pokeboxIrUniforms.uCardTex.value = currentCardTexture;
        pokeboxIrUniforms.uCardBackTex.value = currentCardTexture;
        pokeboxIrUniforms.uMaskTex.value = currentCardMask;
        pokeboxIrUniforms.uFoilTex.value = emptyMask;
        pokeboxIrUniforms.uHasFoil.value = 0;
        pokeboxIrUniforms.uHasGlitter.value = 1;
        pokeboxIrUniforms.uCardOpacity.value = state.intensity / 100;
        coverMesh.material = pokeboxIrMaterial;
      };

      const applyPokeboxEffectToCurrentCard = async () => {
        const reference = await loadPokeboxReference();
        if (!pokeboxSirMaterial || !pokeboxSirUniforms || !currentCardTexture || !currentCardMask) {
          throw new Error("La matière Pokebox ou la carte active ne sont pas prêtes.");
        }

        const maskMode = (document.querySelector("#material-mask-mode") as HTMLSelectElement | null)?.value ?? "auto";
        const etchMode = (document.querySelector("#material-etch-mode") as HTMLSelectElement | null)?.value ?? "auto";
        const activeMask = maskMode === "full"
          ? effectTextures.neutralMask
          : maskMode === "reference"
            ? reference.mask
            : maskMode === "uploaded" && uploadedMaskTexture
              ? uploadedMaskTexture
              : maskMode === "none"
                ? emptyMask
                : currentCardMask;
        const activeEtch = etchMode === "reference"
          ? reference.foil
          : etchMode === "uploaded" && uploadedEtchTexture
            ? uploadedEtchTexture
            : etchMode === "none"
              ? emptyMask
              : currentCoverProfile === "pokebox-sir"
                ? reference.foil
                : currentCardMask;

        pokeboxSirUniforms.uCardTex.value = currentCardTexture;
        pokeboxSirUniforms.uCardBackTex.value = currentCardTexture;
        pokeboxSirUniforms.uMaskTex.value = activeMask;
        pokeboxSirUniforms.uFoilTex.value = activeEtch;
        pokeboxSirUniforms.uHasFoil.value = etchMode === "none" ? 0 : 1;
        syncMaterialBuilderUniforms();
        coverMesh.material = pokeboxSirMaterial;
      };

      const setCover = async (src: string, profile = "book") => {
        if (renderState instanceof HTMLElement) renderState.textContent = "Chargement de la matière";
        stage.classList.add("is-loading");
        currentCoverProfile = profile;
        currentCardSrc = src;
        try {
          if (profile === "pokebox-sir") {
            const reference = await loadPokeboxReference();
            currentCardTexture = reference.front;
            currentCardMask = reference.mask;
            coverUniforms.uMap.value = reference.front;
            coverUniforms.uMask.value = reference.mask;
            await applyPokeboxEffectToCurrentCard();
          } else {
            const texture = await loadCover(src);
            let mask = loadedMasks.get(src);
            if (!mask) {
              mask = await createAutoFoilMask(texture);
              mask.anisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 4);
              loadedMasks.set(src, mask);
            }
            currentCardTexture = texture;
            currentCardMask = mask;
            coverUniforms.uMap.value = texture;
            coverUniforms.uMask.value = mask;
            coverMesh.material = coverMaterial;
          }
          coverMaterial.needsUpdate = true;
          if (renderState instanceof HTMLElement) {
            renderState.textContent = profile === "pokebox-sir" ? "Référence Pokebox active" : "Rendu en temps réel";
          }
          stage.classList.remove("is-loading");
        } catch (error) {
          if (renderState instanceof HTMLElement) renderState.textContent = "Texture indisponible";
          if (errorState instanceof HTMLElement) {
            errorState.textContent = "La couverture n’a pas pu être chargée. Choisissez une autre carte.";
            errorState.hidden = false;
          }
          console.error(error);
        }
      };
      const state = {
        tilt: 14,
        depth: 18,
        intensity: 72,
        softness: 46,
        pointerFollow: true,
        floatMotion: true,
        autoRotate: false,
        castShadow: true,
        targetRotationX: 0,
        targetRotationY: 0,
        pointerInside: false,
      };

      const modeMap: Record<string, number> = {
        satin: 0,
        holo: 1,
        prism: 2,
        spot: 3,
        "beui-warp": 4,
        "beui-voronoi": 5,
        "beui-orbit": 6,
        "beui-rays": 7,
        "beui-mesh": 8,
        "beui-mesh-aurora": 9,
      };
      const modeLabels: Record<string, string> = {
        satin: "Satin",
        holo: "Holographique",
        prism: "Prismatique",
        spot: "Projecteur",
        "beui-mesh": "beUI · Mesh",
        "beui-mesh-aurora": "beUI · Mesh — Aurora",
        "beui-warp": "beUI · Warp",
        "beui-voronoi": "beUI · Voronoï",
        "beui-orbit": "beUI · Dot Orbit",
        "beui-rays": "beUI · God Rays",
        "pokebox-ir": "Pokebox · Illustration Rare (#168)",
        "pokebox-sir": "Pokebox · Special Illustration Rare",
      };
      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      const animationStartedAt = performance.now();
      let previousFrameAt = animationStartedAt;
      let animationFrame = 0;
      let isDisposed = false;

      const resize = () => {
        const rect = stage.getBoundingClientRect();
        const width = Math.max(1, rect.width);
        const height = Math.max(1, rect.height);
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(stage);
      resize();

      const updatePointer = (event: PointerEvent) => {
        const rect = canvas.getBoundingClientRect();
        const localX = (event.clientX - rect.left) / rect.width;
        const localY = (event.clientY - rect.top) / rect.height;
        pointer.x = localX * 2 - 1;
        pointer.y = -(localY * 2 - 1);
        state.pointerInside = true;

        if (!reduceMotion) {
          const maxTilt = THREE.MathUtils.degToRad(state.tilt);
          state.targetRotationY = (localX - 0.5) * maxTilt * 1.6;
          state.targetRotationX = (0.5 - localY) * maxTilt;
        }

        raycaster.setFromCamera(pointer, camera);
        const hit = raycaster.intersectObject(coverMesh, false)[0];
        if (hit?.uv && state.pointerFollow) {
          coverUniforms.uPointer.value.lerp(hit.uv, 0.42);
          setBookFoilPointer(coverUniforms, coverUniforms.uPointer.value);
          if (pokeboxSirUniforms) {
            pokeboxSirUniforms.uPointer.value.lerp(hit.uv, 0.42);
            setPokeboxSpecialIllustrationPointer(pokeboxSirUniforms, pokeboxSirUniforms.uPointer.value);
          }
          if (pokeboxIrUniforms) {
            pokeboxIrUniforms.uPointer.value.lerp(hit.uv, 0.42);
            setPokeboxIllustrationRarePointer(pokeboxIrUniforms, pokeboxIrUniforms.uPointer.value);
          }
          keyLight.position.x = THREE.MathUtils.lerp(-4.2, 4.2, hit.uv.x);
          keyLight.position.y = THREE.MathUtils.lerp(-3.5, 5.2, hit.uv.y);
        }
      };

      const leavePointer = () => {
        state.pointerInside = false;
        state.targetRotationX = 0;
        state.targetRotationY = 0;
      };

      canvas.addEventListener("pointermove", updatePointer);
      canvas.addEventListener("pointerleave", leavePointer);
      canvas.addEventListener("pointercancel", leavePointer);

      const setPressed = (selector: string, current: HTMLButtonElement) => {
        document.querySelectorAll(selector).forEach((element) => {
          if (element instanceof HTMLButtonElement) element.setAttribute("aria-pressed", String(element === current));
        });
      };

      document.querySelectorAll(".cover-option").forEach((button) => {
        button.addEventListener("click", async () => {
          if (!(button instanceof HTMLButtonElement)) return;
          setPressed(".cover-option", button);
          const src = button.dataset.coverSrc;
          const profile = button.dataset.coverProfile ?? "book";
          const defaultEffect = button.dataset.coverEffect;
          if (src) await setCover(src, profile);
          currentCardTitle = button.dataset.coverTitle ?? "Carte sans titre";
          if (profile === "pokebox-sir") {
            setRangeValue("intensity", 82);
            chooseEffect("pokebox-sir");
          } else if (defaultEffect) {
            chooseEffect(defaultEffect);
          } else if (currentEffect === "pokebox-sir") {
            chooseEffect("holo");
          }
          const title = document.querySelector("#stage-book-title");
          const edition = document.querySelector("#stage-book-edition");
          if (title instanceof HTMLElement) title.textContent = button.dataset.coverTitle ?? "";
          if (edition instanceof HTMLElement) edition.textContent = button.dataset.coverEdition ?? "";
        });
      });

      document.querySelectorAll(".effect-option").forEach((button) => {
        button.addEventListener("click", async () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const effect = button.dataset.effect ?? "holo";

          setPressed(".effect-option", button);
          currentEffect = effect;
          if (effect === "pokebox-sir") {
            try {
              if (renderState instanceof HTMLElement) renderState.textContent = "Chargement de l’effet Pokebox";
              await applyPokeboxEffectToCurrentCard();
              if (renderState instanceof HTMLElement) {
                renderState.textContent = currentCoverProfile === "pokebox-sir"
                  ? "Référence Pokebox active"
                  : "Effet Pokebox appliqué à la carte";
              }
            } catch (error) {
              currentEffect = "holo";
              coverMesh.material = coverMaterial;
              coverUniforms.uMode.value = modeMap.holo ?? 1;
              const holoButton = document.querySelector('[data-effect="holo"]');
              if (holoButton instanceof HTMLButtonElement) setPressed(".effect-option", holoButton);
              if (renderState instanceof HTMLElement) renderState.textContent = "Effet Pokebox indisponible";
              console.error(error);
            }
          } else if (effect === "pokebox-ir") {
            try {
              if (renderState instanceof HTMLElement) renderState.textContent = "Chargement de l’effet Illustration Rare";
              await applyPokeboxIllustrationRareToCurrentCard();
              if (renderState instanceof HTMLElement) renderState.textContent = "Pokebox Illustration Rare actif";
            } catch (error) {
              currentEffect = "holo";
              coverMesh.material = coverMaterial;
              coverUniforms.uMode.value = modeMap.holo ?? 1;
              const holoButton = document.querySelector('[data-effect="holo"]');
              if (holoButton instanceof HTMLButtonElement) setPressed(".effect-option", holoButton);
              if (renderState instanceof HTMLElement) renderState.textContent = "Illustration Rare indisponible";
              console.error(error);
            }
          } else {
            coverMesh.material = coverMaterial;
            coverUniforms.uMode.value = modeMap[effect] ?? 1;
            if (renderState instanceof HTMLElement) renderState.textContent = "Rendu en temps réel";
          }
          const label = document.querySelector("#stage-effect-label");
          if (label instanceof HTMLElement) label.textContent = modeLabels[currentEffect] ?? "Holographique";
        });
      });
      document.querySelectorAll(".position-option").forEach((button) => {
        button.addEventListener("click", () => {
          if (!(button instanceof HTMLButtonElement)) return;
          setPressed(".position-option", button);
          const x = Number(button.dataset.x ?? 0.5);
          const y = Number(button.dataset.y ?? 0.5);
          coverUniforms.uPointer.value.set(x, y);
          setBookFoilPointer(coverUniforms, coverUniforms.uPointer.value);
          if (pokeboxSirUniforms) {
            pokeboxSirUniforms.uPointer.value.set(x, y);
            setPokeboxSpecialIllustrationPointer(pokeboxSirUniforms, pokeboxSirUniforms.uPointer.value);
          }
          if (pokeboxIrUniforms) {
            pokeboxIrUniforms.uPointer.value.set(x, y);
            setPokeboxIllustrationRarePointer(pokeboxIrUniforms, pokeboxIrUniforms.uPointer.value);
          }
          keyLight.position.x = THREE.MathUtils.lerp(-4.2, 4.2, x);
          keyLight.position.y = THREE.MathUtils.lerp(-3.5, 5.2, y);
        });
      });

      type MaterialPresetConfig = {
        schema: "vanya-pokebox-material";
        version: 1;
        name: string;
        card?: { title: string; src: string };
        maskMode?: string;
        etchMode?: string;
        tint?: string;
        tintStrength?: number;
        layers?: Record<string, { enabled: boolean; intensity: number }>;
        uniforms?: Record<string, number>;
        view?: { intensity: number; tilt: number; depth: number; softness: number };
      };

      const builderStatus = document.querySelector("#builder-status");
      const setBuilderStatus = (message: string) => {
        if (builderStatus instanceof HTMLElement) builderStatus.textContent = message;
      };

      const readSelectValue = (selector: string, fallback: string) => {
        const select = document.querySelector(selector);
        return select instanceof HTMLSelectElement ? select.value : fallback;
      };

      function refreshBuilderOutputs() {
        document.querySelectorAll<HTMLInputElement>("[data-layer-uniform]").forEach((input) => {
          const output = document.querySelector(`[data-layer-output="${input.dataset.layerUniform}"]`);
          if (output instanceof HTMLOutputElement) output.textContent = `${Math.round(Number(input.value))}%`;
        });
        document.querySelectorAll<HTMLInputElement>("[data-material-uniform]").forEach((input) => {
          const output = document.querySelector(`[data-material-output="${input.dataset.materialUniform}"]`);
          if (output instanceof HTMLOutputElement) output.textContent = `${input.value}${input.dataset.suffix ?? ""}`;
        });
        const tintStrength = document.querySelector("#material-tint-strength");
        const tintOutput = document.querySelector("#material-tint-strength-output");
        if (tintStrength instanceof HTMLInputElement && tintOutput instanceof HTMLOutputElement) {
          tintOutput.textContent = `${tintStrength.value}%`;
        }
      }

      function serializeMaterialPreset(name?: string): MaterialPresetConfig {
        const layers: MaterialPresetConfig["layers"] = {};
        document.querySelectorAll<HTMLInputElement>("[data-layer-uniform]").forEach((input) => {
          const uniform = input.dataset.layerUniform;
          if (!uniform) return;
          const enabled = document.querySelector(`[data-layer-enabled="${uniform}"]`);
          layers[uniform] = {
            enabled: enabled instanceof HTMLInputElement ? enabled.checked : true,
            intensity: Number(input.value),
          };
        });
        const uniforms: Record<string, number> = {};
        document.querySelectorAll<HTMLInputElement>("[data-material-uniform]").forEach((input) => {
          if (input.dataset.materialUniform) uniforms[input.dataset.materialUniform] = Number(input.value);
        });
        const tint = document.querySelector("#material-tint");
        const tintStrength = document.querySelector("#material-tint-strength");
        const nameInput = document.querySelector("#material-preset-name");
        return {
          schema: "vanya-pokebox-material",
          version: 1,
          name: name ?? ((nameInput instanceof HTMLInputElement ? nameInput.value.trim() : "Ma matière") || "Ma matière"),
          card: { title: currentCardTitle, src: currentCardSrc },
          maskMode: readSelectValue("#material-mask-mode", "auto"),
          etchMode: readSelectValue("#material-etch-mode", "auto"),
          tint: tint instanceof HTMLInputElement ? tint.value : "#fff1d2",
          tintStrength: tintStrength instanceof HTMLInputElement ? Number(tintStrength.value) : 0,
          layers,
          uniforms,
          view: {
            intensity: state.intensity,
            tilt: state.tilt,
            depth: state.depth,
            softness: state.softness,
          },
        };
      }

      function updateMaterialJsonPreview() {
        const textarea = document.querySelector("#material-preset-json");
        if (textarea instanceof HTMLTextAreaElement) {
          textarea.value = JSON.stringify(serializeMaterialPreset(), null, 2);
        }
      }

      function syncMaterialBuilderUniforms() {
        if (!pokeboxSirUniforms) return;
        document.querySelectorAll<HTMLInputElement>("[data-layer-uniform]").forEach((input) => {
          const uniformName = input.dataset.layerUniform;
          if (!uniformName || !pokeboxSirUniforms?.[uniformName]) return;
          const enabled = document.querySelector(`[data-layer-enabled="${uniformName}"]`);
          const isEnabled = !(enabled instanceof HTMLInputElement) || enabled.checked;
          pokeboxSirUniforms[uniformName].value = isEnabled ? Number(input.value) / 100 : 0;
        });
        document.querySelectorAll<HTMLInputElement>("[data-material-uniform]").forEach((input) => {
          const uniformName = input.dataset.materialUniform;
          if (uniformName && pokeboxSirUniforms?.[uniformName]) {
            pokeboxSirUniforms[uniformName].value = Number(input.value);
          }
        });
        const tint = document.querySelector("#material-tint");
        const tintStrength = document.querySelector("#material-tint-strength");
        if (tint instanceof HTMLInputElement) {
          const tintUniform = pokeboxSirUniforms.uMaterialTint.value;
          if (tintUniform instanceof THREE.Color) tintUniform.set(tint.value);
        }
        if (tintStrength instanceof HTMLInputElement) {
          pokeboxSirUniforms.uTintStrength.value = Number(tintStrength.value) / 100;
        }
        pokeboxSirUniforms.uCardOpacity.value = state.intensity / 100;
        refreshBuilderOutputs();
        updateMaterialJsonPreview();
      }

      const activateMaterialBuilder = async () => {
        const button = document.querySelector('[data-effect="pokebox-sir"]');
        if (button instanceof HTMLButtonElement) setPressed(".effect-option", button);
        currentEffect = "pokebox-sir";
        try {
          setBuilderStatus("Application de la matière…");
          await applyPokeboxEffectToCurrentCard();
          const label = document.querySelector("#stage-effect-label");
          if (label instanceof HTMLElement) label.textContent = modeLabels["pokebox-sir"];
          if (renderState instanceof HTMLElement) renderState.textContent = "Material Builder actif";
          setBuilderStatus("Matière Pokebox appliquée à la carte sélectionnée.");
        } catch (error) {
          setBuilderStatus("La matière n’a pas pu être appliquée.");
          console.error(error);
        }
      };

      const requestMaterialUpdate = () => {
        refreshBuilderOutputs();
        if (currentEffect === "pokebox-sir" && pokeboxSirUniforms) {
          syncMaterialBuilderUniforms();
        } else {
          void activateMaterialBuilder();
        }
      };

      const loadUploadedMaterialTexture = async (file: File) => {
        const objectUrl = URL.createObjectURL(file);
        try {
          const texture = await textureLoader.loadAsync(objectUrl);
          texture.colorSpace = THREE.NoColorSpace;
          texture.minFilter = THREE.LinearMipmapLinearFilter;
          texture.magFilter = THREE.LinearFilter;
          texture.anisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 8);
          return texture;
        } finally {
          URL.revokeObjectURL(objectUrl);
        }
      };

      document.querySelector("#activate-builder")?.addEventListener("click", () => void activateMaterialBuilder());
      ["#material-mask-mode", "#material-etch-mode"].forEach((selector) => {
        document.querySelector(selector)?.addEventListener("change", () => void activateMaterialBuilder());
      });

      const maskFileInput = document.querySelector("#material-mask-file");
      maskFileInput?.addEventListener("change", async () => {
        if (!(maskFileInput instanceof HTMLInputElement) || !maskFileInput.files?.[0]) return;
        try {
          const texture = await loadUploadedMaterialTexture(maskFileInput.files[0]);
          uploadedMaskTexture?.dispose();
          uploadedMaskTexture = texture;
          const select = document.querySelector("#material-mask-mode");
          if (select instanceof HTMLSelectElement) select.value = "uploaded";
          setBuilderStatus(`Masque « ${maskFileInput.files[0].name} » chargé.`);
          await activateMaterialBuilder();
        } catch (error) {
          setBuilderStatus("Impossible de lire ce masque.");
          console.error(error);
        }
      });

      const etchFileInput = document.querySelector("#material-etch-file");
      etchFileInput?.addEventListener("change", async () => {
        if (!(etchFileInput instanceof HTMLInputElement) || !etchFileInput.files?.[0]) return;
        try {
          const texture = await loadUploadedMaterialTexture(etchFileInput.files[0]);
          uploadedEtchTexture?.dispose();
          uploadedEtchTexture = texture;
          const select = document.querySelector("#material-etch-mode");
          if (select instanceof HTMLSelectElement) select.value = "uploaded";
          setBuilderStatus(`Gravure « ${etchFileInput.files[0].name} » chargée.`);
          await activateMaterialBuilder();
        } catch (error) {
          setBuilderStatus("Impossible de lire cette gravure.");
          console.error(error);
        }
      });

      document.querySelectorAll<HTMLInputElement>("[data-layer-uniform], [data-material-uniform], #material-tint-strength").forEach((input) => {
        input.addEventListener("input", requestMaterialUpdate);
      });
      document.querySelectorAll<HTMLInputElement>("[data-layer-enabled]").forEach((input) => {
        input.addEventListener("change", requestMaterialUpdate);
      });
      document.querySelector("#material-tint")?.addEventListener("input", requestMaterialUpdate);

      const applyMaterialPresetConfig = async (preset: Partial<MaterialPresetConfig>) => {
        const maskSelect = document.querySelector("#material-mask-mode");
        const etchSelect = document.querySelector("#material-etch-mode");
        if (maskSelect instanceof HTMLSelectElement && preset.maskMode) {
          maskSelect.value = preset.maskMode === "uploaded" && !uploadedMaskTexture ? "auto" : preset.maskMode;
        }
        if (etchSelect instanceof HTMLSelectElement && preset.etchMode) {
          etchSelect.value = preset.etchMode === "uploaded" && !uploadedEtchTexture ? "auto" : preset.etchMode;
        }
        if (preset.tint) {
          const tint = document.querySelector("#material-tint");
          if (tint instanceof HTMLInputElement) tint.value = preset.tint;
        }
        if (typeof preset.tintStrength === "number") {
          const strength = document.querySelector("#material-tint-strength");
          if (strength instanceof HTMLInputElement) strength.value = String(preset.tintStrength);
        }
        Object.entries(preset.layers ?? {}).forEach(([uniform, layer]) => {
          const range = document.querySelector(`[data-layer-uniform="${uniform}"]`);
          const enabled = document.querySelector(`[data-layer-enabled="${uniform}"]`);
          if (range instanceof HTMLInputElement) range.value = String(layer.intensity);
          if (enabled instanceof HTMLInputElement) enabled.checked = layer.enabled;
        });
        Object.entries(preset.uniforms ?? {}).forEach(([uniform, value]) => {
          const input = document.querySelector(`[data-material-uniform="${uniform}"]`);
          if (input instanceof HTMLInputElement && Number.isFinite(value)) input.value = String(value);
        });
        if (preset.view) {
          setRangeValue("intensity", preset.view.intensity);
          setRangeValue("tilt", preset.view.tilt);
          setRangeValue("depth", preset.view.depth);
          setRangeValue("softness", preset.view.softness);
        }
        const name = document.querySelector("#material-preset-name");
        if (name instanceof HTMLInputElement && preset.name) name.value = preset.name;
        refreshBuilderOutputs();
        await activateMaterialBuilder();
        updateMaterialJsonPreview();
      };

      const starterPresets: Record<string, Partial<MaterialPresetConfig>> = {
        nacre: {
          name: "Nacre douce", tint: "#ffe8df", tintStrength: 18, maskMode: "auto", etchMode: "auto",
          layers: {
            uLayerSilver: { enabled: true, intensity: 68 }, uLayerShine: { enabled: true, intensity: 52 },
            uLayerWash: { enabled: true, intensity: 45 }, uLayerGlitter: { enabled: true, intensity: 24 },
            uLayerGlare: { enabled: true, intensity: 34 }, uLayerEtch: { enabled: true, intensity: 40 },
          },
          uniforms: { uSirShineSaturation: 1.3, uSirWashSaturation: 0.55, uSirGlitterContrast: 1.45, uSirBaseBrightness: 1.04 },
        },
        argent: {
          name: "Argent gravé", tint: "#e5eef2", tintStrength: 16, maskMode: "auto", etchMode: "auto",
          layers: {
            uLayerSilver: { enabled: true, intensity: 100 }, uLayerShine: { enabled: true, intensity: 34 },
            uLayerWash: { enabled: true, intensity: 22 }, uLayerGlitter: { enabled: true, intensity: 28 },
            uLayerGlare: { enabled: true, intensity: 50 }, uLayerEtch: { enabled: true, intensity: 100 },
          },
          uniforms: { uSirShineSaturation: 0.4, uSirWashSaturation: 0.25, uSirGlitterSaturation: 0.15, uSirBaseContrast: 1.08, uSirTiltSparkleIntensity: 0.62 },
        },
        dore: {
          name: "Dorure chaude", tint: "#e4a744", tintStrength: 68, maskMode: "auto", etchMode: "auto",
          layers: {
            uLayerSilver: { enabled: true, intensity: 42 }, uLayerShine: { enabled: true, intensity: 42 },
            uLayerWash: { enabled: true, intensity: 36 }, uLayerGlitter: { enabled: true, intensity: 34 },
            uLayerGlare: { enabled: true, intensity: 38 }, uLayerEtch: { enabled: true, intensity: 78 },
          },
          uniforms: { uSirShineSaturation: 0.75, uSirWashSaturation: 0.5, uSirGlitterContrast: 2.7, uSirBaseBrightness: 0.98 },
        },
        cosmique: {
          name: "Cosmique", tint: "#8b7cff", tintStrength: 42, maskMode: "auto", etchMode: "auto",
          layers: {
            uLayerSilver: { enabled: true, intensity: 62 }, uLayerShine: { enabled: true, intensity: 100 },
            uLayerWash: { enabled: true, intensity: 92 }, uLayerGlitter: { enabled: true, intensity: 90 },
            uLayerGlare: { enabled: true, intensity: 58 }, uLayerEtch: { enabled: true, intensity: 72 },
          },
          uniforms: { uSirShineFrequency: 2.4, uSirShineSaturation: 4.2, uSirWashScale: 1.8, uSirWashSaturation: 1.55, uSirGlitterSaturation: 2.2 },
        },
      };

      document.querySelectorAll<HTMLButtonElement>("[data-material-preset]").forEach((button) => {
        button.addEventListener("click", () => {
          const preset = button.dataset.materialPreset ? starterPresets[button.dataset.materialPreset] : null;
          if (preset) void applyMaterialPresetConfig(preset);
        });
      });

      const presetStorageKey = "vanya-pokebox-material-presets-v1";
      const readStoredPresets = (): Record<string, MaterialPresetConfig> => {
        try {
          const value = localStorage.getItem(presetStorageKey);
          return value ? JSON.parse(value) : {};
        } catch {
          return {};
        }
      };
      const renderStoredPresets = () => {
        const select = document.querySelector("#saved-material-presets");
        if (!(select instanceof HTMLSelectElement)) return;
        const selected = select.value;
        select.replaceChildren(new Option("Choisir un preset local", ""));
        Object.keys(readStoredPresets()).sort((a, b) => a.localeCompare(b, "fr")).forEach((name) => select.add(new Option(name, name)));
        select.value = selected;
      };

      document.querySelector("#save-material-preset")?.addEventListener("click", () => {
        const preset = serializeMaterialPreset();
        const presets = readStoredPresets();
        presets[preset.name] = preset;
        try {
          localStorage.setItem(presetStorageKey, JSON.stringify(presets));
          renderStoredPresets();
          const select = document.querySelector("#saved-material-presets");
          if (select instanceof HTMLSelectElement) select.value = preset.name;
          setBuilderStatus(`Preset « ${preset.name} » enregistré dans ce navigateur.`);
        } catch {
          setBuilderStatus("Le navigateur a refusé l’enregistrement local.");
        }
      });

      document.querySelector("#saved-material-presets")?.addEventListener("change", (event) => {
        const select = event.currentTarget;
        if (!(select instanceof HTMLSelectElement) || !select.value) return;
        const preset = readStoredPresets()[select.value];
        if (preset) void applyMaterialPresetConfig(preset);
      });

      document.querySelector("#download-material-preset")?.addEventListener("click", () => {
        const preset = serializeMaterialPreset();
        const blob = new Blob([JSON.stringify(preset, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `${preset.name.toLowerCase().replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "") || "matiere-pokebox"}.json`;
        link.click();
        URL.revokeObjectURL(url);
        setBuilderStatus("Preset JSON téléchargé.");
      });

      const applyJsonTextarea = async () => {
        const textarea = document.querySelector("#material-preset-json");
        if (!(textarea instanceof HTMLTextAreaElement)) return;
        try {
          const preset = JSON.parse(textarea.value) as MaterialPresetConfig;
          if (preset.schema !== "vanya-pokebox-material" || preset.version !== 1) throw new Error("Format inconnu");
          await applyMaterialPresetConfig(preset);
          setBuilderStatus(`Preset « ${preset.name || "sans nom"} » appliqué.`);
        } catch (error) {
          setBuilderStatus("JSON invalide ou format de preset incompatible.");
          console.error(error);
        }
      };
      document.querySelector("#apply-material-json")?.addEventListener("click", () => void applyJsonTextarea());

      const importPresetInput = document.querySelector("#import-material-preset");
      importPresetInput?.addEventListener("change", async () => {
        if (!(importPresetInput instanceof HTMLInputElement) || !importPresetInput.files?.[0]) return;
        const textarea = document.querySelector("#material-preset-json");
        if (textarea instanceof HTMLTextAreaElement) textarea.value = await importPresetInput.files[0].text();
        await applyJsonTextarea();
      });

      document.querySelectorAll<HTMLButtonElement>("[data-capture-slot]").forEach((button) => {
        button.addEventListener("click", () => {
          const slot = button.dataset.captureSlot;
          const figure = slot ? document.querySelector(`[data-comparison="${slot}"]`) : null;
          if (!(figure instanceof HTMLElement)) return;
          renderer.render(scene, camera);
          const image = figure.querySelector("img");
          const placeholder = figure.querySelector(".comparison-placeholder");
          const caption = figure.querySelector("figcaption small");
          if (image instanceof HTMLImageElement) {
            image.src = renderer.domElement.toDataURL("image/png");
            image.hidden = false;
          }
          if (placeholder instanceof HTMLElement) placeholder.hidden = true;
          if (caption instanceof HTMLElement) {
            caption.textContent = `${currentCardTitle} · ${readSelectValue("#material-mask-mode", "auto")} / ${readSelectValue("#material-etch-mode", "auto")}`;
          }
          setBuilderStatus(`Variante ${slot?.toUpperCase()} capturée.`);
        });
      });

      document.querySelector("#clear-comparison")?.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>("[data-comparison]").forEach((figure) => {
          const image = figure.querySelector("img");
          const placeholder = figure.querySelector(".comparison-placeholder");
          const caption = figure.querySelector("figcaption small");
          if (image instanceof HTMLImageElement) { image.src = ""; image.hidden = true; }
          if (placeholder instanceof HTMLElement) placeholder.hidden = false;
          if (caption instanceof HTMLElement) caption.textContent = "Aucune capture";
        });
      });

      refreshBuilderOutputs();
      renderStoredPresets();
      updateMaterialJsonPreview();
      type NumericStateKey = "tilt" | "depth" | "intensity" | "softness";
      type BooleanStateKey = "pointerFollow" | "floatMotion" | "autoRotate" | "castShadow";

      const bindRange = (
        id: string,
        stateKey: NumericStateKey,
        outputId: string,
        suffix: string,
        update?: (value: number) => void,
      ) => {
        const input = document.querySelector(`#${id}`);
        const output = document.querySelector(`#${outputId}`);
        if (!(input instanceof HTMLInputElement)) return;
        const sync = () => {
          const value = Number(input.value);
          state[stateKey] = value;
          if (output instanceof HTMLOutputElement) output.textContent = `${value}${suffix}`;
          update?.(value);
        };
        input.addEventListener("input", sync);
        sync();
      };

      bindRange("intensity", "intensity", "intensity-output", "%", (value) => {
        coverUniforms.uIntensity.value = value / 100;
        if (pokeboxSirUniforms) pokeboxSirUniforms.uCardOpacity.value = value / 100;
        if (pokeboxIrUniforms) pokeboxIrUniforms.uCardOpacity.value = value / 100;
      });
      bindRange("tilt", "tilt", "tilt-output", "°");
      bindRange("depth", "depth", "depth-output", "%", (value) => {
        cardFloat.scale.z = THREE.MathUtils.lerp(0.4, 2.1, value / 36);
      });
      bindRange("softness", "softness", "softness-output", "%", (value) => {
        coverUniforms.uSoftness.value = value / 100;
      });

      const bindToggle = (
        id: string,
        stateKey: BooleanStateKey,
        update?: (enabled: boolean) => void,
      ) => {
        const input = document.querySelector(`#${id}`);
        if (!(input instanceof HTMLInputElement)) return;
        const sync = () => {
          state[stateKey] = input.checked;
          update?.(input.checked);
        };
        input.addEventListener("change", sync);
        sync();
      };

      bindToggle("pointer-follow", "pointerFollow");
      bindToggle("float-motion", "floatMotion");
      bindToggle("auto-rotate", "autoRotate");
      bindToggle("cast-shadow", "castShadow", (enabled) => {
        volume.castShadow = enabled;
        coverMesh.castShadow = enabled;
        floor.visible = enabled;
      });

      const setRangeValue = (id: string, value: number) => {
        const input = document.querySelector(`#${id}`);
        if (input instanceof HTMLInputElement) {
          input.value = String(value);
          input.dispatchEvent(new Event("input"));
        }
      };

      const chooseEffect = (effect: string) => {
        const button = document.querySelector(`[data-effect="${effect}"]`);
        if (button instanceof HTMLButtonElement) button.click();
      };

      const applyPreset = (preset: string) => {
        if (preset === "velvet") {
          chooseEffect("satin");
          setRangeValue("intensity", 38);
          setRangeValue("softness", 78);
          setRangeValue("tilt", 9);
          setRangeValue("depth", 24);
        }
        if (preset === "chrome") {
          chooseEffect("spot");
          setRangeValue("intensity", 86);
          setRangeValue("softness", 24);
          setRangeValue("tilt", 17);
          setRangeValue("depth", 30);
        }
        if (preset === "spectrum") {
          chooseEffect("prism");
          setRangeValue("intensity", 88);
          setRangeValue("softness", 34);
          setRangeValue("tilt", 15);
          setRangeValue("depth", 18);
        }
      };

      document.querySelectorAll("[data-preset]").forEach((button) => {
        button.addEventListener("click", () => {
          if (button instanceof HTMLButtonElement && button.dataset.preset) applyPreset(button.dataset.preset);
        });
      });

      const reset = () => {
        chooseEffect("holo");
        setRangeValue("intensity", 72);
        setRangeValue("tilt", 14);
        setRangeValue("depth", 18);
        setRangeValue("softness", 46);
        const toggleDefaults: Array<[string, boolean]> = [
          ["pointer-follow", true],
          ["float-motion", true],
          ["auto-rotate", false],
          ["cast-shadow", true],
        ];
        toggleDefaults.forEach(([id, checked]) => {
          const input = document.querySelector(`#${id}`);
          if (input instanceof HTMLInputElement) {
            input.checked = checked;
            input.dispatchEvent(new Event("change"));
          }
        });
        const center = document.querySelector('[data-position="center"]');
        if (center instanceof HTMLButtonElement) center.click();
      };

      document.querySelector("#reset-controls")?.addEventListener("click", reset);

      const animate = (now = performance.now()) => {
        if (isDisposed) return;
        animationFrame = window.requestAnimationFrame(animate);
        const delta = Math.min((now - previousFrameAt) / 1000, 0.05);
        previousFrameAt = now;
        const elapsed = (now - animationStartedAt) / 1000;
        coverUniforms.uTime.value = reduceMotion ? 0 : elapsed;
        if (pokeboxIrUniforms) pokeboxIrUniforms.uTime.value = reduceMotion ? 0 : elapsed;

        const autoY = !reduceMotion && state.autoRotate ? Math.sin(elapsed * 0.42) * 0.16 : 0;
        const targetX = reduceMotion ? 0 : state.targetRotationX;
        const targetY = reduceMotion ? 0 : state.targetRotationY + autoY;
        cardRoot.rotation.x = THREE.MathUtils.damp(cardRoot.rotation.x, targetX, 8.5, delta);
        cardRoot.rotation.y = THREE.MathUtils.damp(cardRoot.rotation.y, targetY, 8.5, delta);
        cardRoot.quaternion.normalize();

        cardFloat.position.y = !reduceMotion && state.floatMotion ? Math.sin(elapsed * 0.85) * 0.075 : 0;
        cardFloat.rotation.z = !reduceMotion && state.floatMotion ? Math.sin(elapsed * 0.46) * 0.012 : 0;

        renderer.render(scene, camera);
      };

      const dispose = () => {
        if (isDisposed) return;
        isDisposed = true;
        window.cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        canvas.removeEventListener("pointermove", updatePointer);
        canvas.removeEventListener("pointerleave", leavePointer);
        canvas.removeEventListener("pointercancel", leavePointer);
        loadedTextures.forEach((texture) => texture.dispose());
        loadedMasks.forEach((texture) => texture.dispose());
        pokeboxReferenceTextures.forEach((texture) => texture.dispose());
        uploadedMaskTexture?.dispose();
        uploadedEtchTexture?.dispose();
        emptyMask.dispose();
        effectTextures.neutralMask.dispose();
        effectTextures.foil.dispose();
        effectTextures.glitter.dispose();
        environmentRenderTarget.dispose();
        volumeGeometry.dispose();
        coverGeometry.dispose();
        floor.geometry.dispose();
        edgeMaterial.dispose();
        coverMaterial.dispose();
        pokeboxIrMaterial?.dispose();
        pokeboxSirMaterial?.dispose();
        backMaterial.dispose();
        floorMaterial.dispose();
        renderer.dispose();
      };

      window.addEventListener("pagehide", dispose, { once: true });
      document.addEventListener("astro:before-swap", dispose, { once: true });

      const query = new URLSearchParams(window.location.search);
      const requestedPokeboxReference = query.get("set") === "sv3-5_en" && query.get("card") === "199";
      if (requestedPokeboxReference) {
        const referenceCover = document.querySelector('[data-cover-profile="pokebox-sir"]');
        if (referenceCover instanceof HTMLButtonElement) referenceCover.click();
      } else {
        setCover("/assets/card-tests/collibris/aube-musique.webp");
      }
      animate();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    --lab-bg: #e8ebe8;
    --lab-surface: #f6f7f4;
    --lab-surface-strong: #dde2de;
    --lab-stage: #d3d9d5;
    --lab-ink: #1e2420;
    --lab-muted: #5e6861;
    --lab-line: rgb(30 36 32 / 0.14);
    --lab-accent: #526f61;
    --lab-accent-ink: #f5f8f5;
    --lab-shadow: rgb(28 42 34 / 0.2);
    --lab-radius: 14px;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --lab-bg: #111512;
      --lab-surface: #191e1a;
      --lab-surface-strong: #222923;
      --lab-stage: #171c18;
      --lab-ink: #edf1ed;
      --lab-muted: #9ca69f;
      --lab-line: rgb(237 241 237 / 0.12);
      --lab-accent: #7f9d8e;
      --lab-accent-ink: #101511;
      --lab-shadow: rgb(0 0 0 / 0.38);
      color-scheme: dark;
    }
  }

  :global(body.card-lab-body) {
    min-width: 320px;
    min-height: 100dvh;
    margin: 0;
    overflow-x: hidden;
    background: var(--lab-bg);
    color: var(--lab-ink);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  button,
  a,
  input {
    -webkit-tap-highlight-color: transparent;
  }

  button,
  a {
    font: inherit;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--lab-accent);
    outline-offset: 3px;
  }

  .card-lab-shell {
    width: min(calc(100% - 32px), 1500px);
    margin-inline: auto;
    padding-bottom: 28px;
  }

  .lab-header {
    display: flex;
    min-height: 74px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--lab-line);
  }

  .brand-link,
  .exit-link {
    color: inherit;
    text-decoration: none;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .brand-monogram {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: var(--lab-radius);
    background: var(--lab-ink);
    color: var(--lab-bg);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 15px;
  }

  .brand-link strong,
  .brand-link small {
    display: block;
  }

  .brand-link strong {
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .brand-link small {
    margin-top: 2px;
    color: var(--lab-muted);
    font-size: 11px;
  }

  .exit-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border-radius: var(--lab-radius);
    padding: 10px 12px;
    color: var(--lab-muted);
    font-size: 12px;
    font-weight: 650;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .exit-link:hover {
    background: var(--lab-surface-strong);
    color: var(--lab-ink);
  }

  .exit-link:active,
  button:active {
    transform: translateY(1px);
  }

  .lab-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 410px);
    align-items: end;
    gap: 40px;
    padding: 46px 0 34px;
  }

  .eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 -23px;
    color: var(--lab-accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .lab-intro h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.65rem, 5.4vw, 5.8rem);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 0.93;
  }

  .intro-copy {
    max-width: 42ch;
    margin: 0;
    color: var(--lab-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .lab-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(350px, 0.78fr);
    gap: 14px;
    min-height: 760px;
  }

  .stage-column,
  .control-panel {
    min-width: 0;
  }

  .stage-column {
    display: grid;
    grid-template-rows: minmax(580px, 1fr) auto;
    gap: 14px;
  }

  .stage,
  .control-panel,
  .cover-switcher {
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: var(--lab-surface);
    box-shadow: 0 24px 80px -55px var(--lab-shadow);
  }

  .stage {
    position: relative;
    min-height: 580px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 43%, color-mix(in srgb, var(--lab-accent) 12%, transparent), transparent 42%),
      var(--lab-stage);
    isolation: isolate;
  }

  .stage::after {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--lab-ink) 12%, transparent) 0.7px, transparent 0.8px);
    background-size: 9px 9px;
    content: "";
    opacity: 0.17;
    pointer-events: none;
    z-index: -1;
  }

  #card-canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 580px;
    cursor: grab;
    opacity: 1;
    touch-action: none;
    transition: opacity 240ms ease;
  }

  #card-canvas:active {
    cursor: grabbing;
  }

  .stage.is-loading #card-canvas {
    opacity: 0.3;
  }

  .stage-topline,
  .stage-help {
    position: absolute;
    right: 18px;
    left: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    pointer-events: none;
  }

  .stage-topline {
    top: 18px;
  }

  .stage-help {
    bottom: 18px;
    color: var(--lab-muted);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stage-topline strong,
  .stage-topline small {
    display: block;
  }

  .stage-topline strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    font-weight: 500;
  }

  .stage-topline small {
    margin-top: 3px;
    color: var(--lab-muted);
    font-size: 10px;
  }

  .render-state {
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: color-mix(in srgb, var(--lab-surface) 82%, transparent);
    padding: 8px 10px;
    color: var(--lab-muted);
    font-size: 10px;
    font-weight: 700;
    backdrop-filter: blur(14px);
  }

  .stage-error {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(86%, 420px);
    transform: translate(-50%, -50%);
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: var(--lab-surface);
    padding: 20px;
    color: var(--lab-ink);
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  .cover-switcher {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 8px;
  }

  .cover-option {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    gap: 11px;
    min-width: 0;
    border: 1px solid transparent;
    border-radius: var(--lab-radius);
    background: transparent;
    padding: 8px;
    color: var(--lab-muted);
    text-align: left;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  .cover-option:hover {
    color: var(--lab-ink);
  }

  .cover-option[aria-pressed="true"] {
    border-color: var(--lab-line);
    background: var(--lab-surface-strong);
    color: var(--lab-ink);
  }

  .cover-option img {
    width: 42px;
    height: 55px;
    border-radius: 5px;
    object-fit: cover;
    box-shadow: 0 8px 20px -12px var(--lab-shadow);
  }

  .cover-option strong,
  .cover-option small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cover-option strong {
    font-size: 11px;
  }

  .cover-option small {
    margin-top: 4px;
    font-size: 9px;
  }

  .control-panel {
    overflow: hidden;
  }

  .panel-heading,
  .control-group,
  .preset-row {
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--lab-line);
    padding: 20px;
  }

  .panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .panel-heading p,
  .panel-heading h2 {
    margin: 0;
  }

  .panel-heading p,
  .control-group legend,
  .preset-row > span {
    color: var(--lab-muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .panel-heading h2 {
    margin-top: 4px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    font-weight: 500;
  }

  .reset-button {
    flex: none;
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: transparent;
    padding: 9px 11px;
    color: var(--lab-muted);
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
  }

  .reset-button:hover {
    background: var(--lab-surface-strong);
    color: var(--lab-ink);
  }

  .control-group legend {
    float: left;
    width: 100%;
    margin-bottom: 14px;
  }

  .control-group legend + * {
    clear: both;
  }

  .effect-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .effect-option {
    display: grid;
    grid-template-columns: 30px 1fr;
    align-items: center;
    gap: 10px;
    min-width: 0;
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: transparent;
    padding: 10px;
    color: var(--lab-muted);
    text-align: left;
    cursor: pointer;
  }

  .effect-option:hover,
  .effect-option[aria-pressed="true"] {
    background: var(--lab-surface-strong);
    color: var(--lab-ink);
  }

  .effect-option[aria-pressed="true"] {
    border-color: color-mix(in srgb, var(--lab-accent) 65%, var(--lab-line));
    box-shadow: inset 3px 0 0 var(--lab-accent);
  }

  .effect-option strong,
  .effect-option small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .effect-option strong {
    font-size: 10px;
  }

  .effect-option small {
    margin-top: 3px;
    font-size: 8px;
  }

  .effect-swatch {
    width: 30px;
    height: 30px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 9px;
    background: #5a635e;
  }

  .effect-swatch--satin {
    background: linear-gradient(135deg, #303632, #aebbb4 52%, #414b45);
  }

  .effect-swatch--holo {
    background: linear-gradient(135deg, #8b9d93, #d9a9af 35%, #9bb9c0 67%, #9ba77c);
  }

  .effect-swatch--prism {
    background: linear-gradient(135deg, #ac7f79, #c4b47d 26%, #71a08b 52%, #7893ad 76%, #987f9f);
  }

  .effect-swatch--spot {
    background: radial-gradient(circle at 35% 28%, #f2ead4, #3b423e 48%, #171a18 75%);
  }

  .effect-swatch--beui-mesh {
    background:
      radial-gradient(circle at 24% 28%, #e0eaff 0 12%, transparent 34%),
      radial-gradient(circle at 70% 30%, #f75092 0 10%, transparent 38%),
      radial-gradient(circle at 34% 82%, #241d9a 0 12%, transparent 42%),
      #9f50d3;
  }


  .effect-swatch--beui-mesh-aurora {
    background:
      radial-gradient(circle at 28% 28%, #00ffb2 0 10%, transparent 36%),
      radial-gradient(circle at 78% 48%, #0072ff 0 12%, transparent 42%),
      radial-gradient(circle at 35% 88%, #a200ff 0 10%, transparent 40%),
      #001a2c;
  }
  .effect-swatch--beui-warp {
    background: conic-gradient(from 225deg at 38% 58%, #596c87, #d092a0, #d3bf79, #6d9b8d, #596c87);
  }


  .effect-swatch--beui-voronoi {
    background:
      linear-gradient(30deg, transparent 24%, rgb(255 255 255 / 0.7) 25% 27%, transparent 28% 74%, rgb(255 255 255 / 0.55) 75% 77%, transparent 78%),
      linear-gradient(150deg, #695c84, #6c9a95 48%, #d1a989);
  }

  .effect-swatch--beui-orbit {
    background-color: #33403d;
    background-image:
      radial-gradient(circle, #e9c9d0 0 2px, transparent 3px),
      radial-gradient(circle, #88b0b4 0 2px, transparent 3px);
    background-position: 0 0, 7px 9px;
    background-size: 13px 13px;
  }

  .effect-swatch--beui-rays {
    background: conic-gradient(from 22deg at 38% 62%, #222927, #dbad80 5%, #35443f 11%, #8daab0 17%, #242b29 24%, #d7a9b2 31%, #222927 40%);
  }
  .effect-swatch--pokebox-ir {
    background:
      radial-gradient(circle at 28% 72%, rgb(255 255 255 / 0.88), transparent 20%),
      repeating-linear-gradient(132deg, #657fca 0 4px, #d7c8ee 5px 8px, #9bc7bd 9px 12px, #665f9f 13px 16px);
  }
  .effect-swatch--pokebox-sir {
    background:
      radial-gradient(circle at 68% 28%, rgb(255 255 255 / 0.9), transparent 22%),
      linear-gradient(135deg, #ad3630, #e5c283 33%, #5f8d83 58%, #714e85 82%);
  }

  .position-control {
    display: grid;
    grid-template-columns: 112px 1fr;
    align-items: center;
    gap: 18px;
  }

  .position-control p {
    margin: 0;
    color: var(--lab-muted);
    font-size: 10px;
    line-height: 1.55;
  }

  .position-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 112px;
    height: 86px;
    overflow: hidden;
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
  }

  .position-option {
    position: relative;
    display: grid;
    place-items: center;
    border: 0;
    border-right: 1px solid var(--lab-line);
    border-bottom: 1px solid var(--lab-line);
    background: transparent;
    cursor: pointer;
  }

  .position-option:nth-child(3n) {
    border-right: 0;
  }

  .position-option:nth-child(n + 7) {
    border-bottom: 0;
  }

  .position-option span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lab-muted);
    opacity: 0.42;
    transition: opacity 180ms ease, transform 180ms ease, background-color 180ms ease;
  }

  .position-option:hover span,
  .position-option[aria-pressed="true"] span {
    background: var(--lab-accent);
    opacity: 1;
    transform: scale(1.55);
  }

  .slider-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 22px;
  }

  .slider-group legend {
    grid-column: 1 / -1;
  }

  .range-control > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 9px;
    color: var(--lab-muted);
    font-size: 9px;
    font-weight: 700;
  }

  .range-control output {
    color: var(--lab-ink);
    font-variant-numeric: tabular-nums;
  }

  input[type="range"] {
    width: 100%;
    height: 18px;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 2px;
    background: var(--lab-line);
  }

  input[type="range"]::-webkit-slider-thumb {
    width: 14px;
    height: 14px;
    margin-top: -6px;
    appearance: none;
    border: 3px solid var(--lab-surface);
    border-radius: 50%;
    background: var(--lab-accent);
    box-shadow: 0 0 0 1px var(--lab-line);
  }

  input[type="range"]::-moz-range-track {
    height: 2px;
    border-radius: 2px;
    background: var(--lab-line);
  }

  input[type="range"]::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 3px solid var(--lab-surface);
    border-radius: 50%;
    background: var(--lab-accent);
    box-shadow: 0 0 0 1px var(--lab-line);
  }

  .toggle-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .toggle-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 34px;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    padding: 10px;
    cursor: pointer;
  }

  .toggle-row strong,
  .toggle-row small {
    display: block;
  }

  .toggle-row strong {
    font-size: 9px;
  }

  .toggle-row small {
    margin-top: 3px;
    color: var(--lab-muted);
    font-size: 8px;
  }

  .toggle-row input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .toggle-row i {
    position: relative;
    width: 34px;
    height: 20px;
    border-radius: var(--lab-radius);
    background: var(--lab-surface-strong);
    box-shadow: inset 0 0 0 1px var(--lab-line);
    transition: background-color 180ms ease;
  }

  .toggle-row i::after {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--lab-muted);
    content: "";
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .toggle-row input:checked + i {
    background: var(--lab-accent);
  }

  .toggle-row input:checked + i::after {
    background: var(--lab-accent-ink);
    transform: translateX(14px);
  }

  .toggle-row:has(input:focus-visible) {
    outline: 2px solid var(--lab-accent);
    outline-offset: 3px;
  }

  .preset-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 0;
  }

  .preset-row > div {
    display: flex;
    gap: 6px;
  }

  .preset-row button {
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: transparent;
    padding: 8px 10px;
    color: var(--lab-muted);
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
  }

  .preset-row button:hover {
    background: var(--lab-accent);
    color: var(--lab-accent-ink);
  }

  .material-builder,
  .comparison-panel {
    margin-top: 10px;
    border: 1px solid var(--lab-line);
    border-radius: calc(var(--lab-radius) + 4px);
    background: var(--lab-surface);
    box-shadow: 0 28px 80px -68px var(--lab-shadow);
  }

  .builder-header,
  .comparison-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    padding: 28px;
    border-bottom: 1px solid var(--lab-line);
  }

  .builder-header .eyebrow,
  .comparison-header .eyebrow {
    margin: 0 0 9px;
  }

  .builder-header h2,
  .comparison-header h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 3vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .builder-header p:last-child,
  .comparison-header p:last-child {
    max-width: 650px;
    margin: 9px 0 0;
    color: var(--lab-muted);
    font-size: 12px;
    line-height: 1.55;
  }

  .builder-primary,
  .builder-secondary,
  .builder-actions button,
  .button-file,
  .material-presets button,
  .comparison-actions button {
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: transparent;
    padding: 10px 12px;
    color: var(--lab-ink);
    font: inherit;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .builder-primary {
    flex: none;
    border-color: var(--lab-accent);
    background: var(--lab-accent);
    padding: 12px 16px;
    color: var(--lab-accent-ink);
  }

  .builder-primary:hover,
  .builder-secondary:hover,
  .builder-actions button:hover,
  .button-file:hover,
  .material-presets button:hover,
  .comparison-actions button:hover {
    border-color: var(--lab-accent);
    background: var(--lab-accent);
    color: var(--lab-accent-ink);
  }

  .builder-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr) minmax(0, 1.08fr) minmax(0, 0.98fr);
  }

  .builder-pane {
    min-width: 0;
    padding: 24px;
    border-right: 1px solid var(--lab-line);
  }

  .builder-pane:last-child {
    border-right: 0;
  }

  .builder-pane-heading {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
    margin-bottom: 22px;
  }

  .builder-pane-heading > span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--lab-line);
    border-radius: 50%;
    color: var(--lab-accent);
    font-size: 9px;
    font-weight: 850;
  }

  .builder-pane-heading h3,
  .builder-pane-heading p {
    margin: 0;
  }

  .builder-pane-heading h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    font-weight: 500;
  }

  .builder-pane-heading p {
    margin-top: 4px;
    color: var(--lab-muted);
    font-size: 9px;
    line-height: 1.45;
  }

  .builder-field,
  .file-field,
  .tint-field {
    display: block;
    margin-bottom: 17px;
  }

  .builder-field > span,
  .file-field > span,
  .tint-field > label {
    display: block;
    margin-bottom: 7px;
    color: var(--lab-muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .builder-field select,
  .builder-field input,
  .builder-field textarea,
  .file-field input[type="file"] {
    width: 100%;
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: var(--lab-bg);
    padding: 10px;
    color: var(--lab-ink);
    font: inherit;
    font-size: 10px;
  }

  .builder-field select,
  .builder-field input {
    min-height: 39px;
  }

  .file-field input[type="file"] {
    padding: 7px;
  }

  .file-field input[type="file"]::file-selector-button {
    margin-right: 8px;
    border: 0;
    border-radius: calc(var(--lab-radius) - 2px);
    background: var(--lab-surface-strong);
    padding: 7px 9px;
    color: var(--lab-ink);
    font: inherit;
    font-size: 9px;
    font-weight: 750;
    cursor: pointer;
  }

  .file-field small {
    display: block;
    margin-top: 6px;
    color: var(--lab-muted);
    font-size: 8px;
    line-height: 1.4;
  }

  .tint-field > div {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: center;
    gap: 12px;
  }

  #material-tint {
    width: 44px;
    height: 42px;
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: var(--lab-bg);
    padding: 4px;
    cursor: pointer;
  }

  .layer-stack {
    display: grid;
    gap: 9px;
  }

  .layer-control {
    border: 1px solid var(--lab-line);
    border-radius: var(--lab-radius);
    background: color-mix(in srgb, var(--lab-bg) 68%, transparent);
    padding: 11px;
  }

  .layer-toggle {
    display: grid;
    grid-template-columns: 30px 1fr;
    align-items: center;
    gap: 9px;
    cursor: pointer;
  }

  .layer-toggle input {
    position: absolute;
    opacity: 0;
  }

  .layer-toggle i {
    position: relative;
    width: 30px;
    height: 18px;
    border-radius: 999px;
    background: var(--lab-surface-strong);
    box-shadow: inset 0 0 0 1px var(--lab-line);
  }

  .layer-toggle i::after {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lab-muted);
    content: "";
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .layer-toggle input:checked + i {
    background: var(--lab-accent);
  }

  .layer-toggle input:checked + i::after {
    background: var(--lab-accent-ink);
    transform: translateX(12px);
  }

  .layer-toggle strong,
  .layer-toggle small {
    display: block;
  }

  .layer-toggle strong {
    font-size: 10px;
  }

  .layer-toggle small {
    margin-top: 2px;
    color: var(--lab-muted);
    font-size: 8px;
  }

  .builder-range {
    display: block;
    margin-top: 10px;
  }

  .builder-range > span {
    margin-bottom: 4px;
  }

  .parameter-fold {
