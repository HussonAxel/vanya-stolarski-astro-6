---
import BookShowcase from "../components/BookShowcase.astro";
import FeaturedBookHeroCommercial from "../components/FeaturedBookHeroCommercial.astro";
import Reviews from "../components/Reviews.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Vanya Stolarski | Romans et illustration de livres" description="Découvrez les romans de Vanya Stolarski et ses prestations d’illustration : couvertures, jaspages, pages de garde et cartographie. Livres, galerie et tarifs.">
  <main class="overflow-hidden bg-[#FFFAFA]">
    <section class="site-shell px-6 pt-32 pb-4">
      <h1 class="font-serif text-3xl text-balance md:text-4xl">Vanya Stolarski, autrice et illustratrice</h1>
      <nav aria-label="Découvrir les deux activités" class="mt-5 flex flex-wrap gap-x-8 gap-y-3 font-sans text-sm underline underline-offset-4">
        <a href="/livres">Découvrir les romans</a>
        <a href="/tarifs">Illustration de livres : prestations et tarifs</a>
      </nav>
    </section>
    <FeaturedBookHeroCommercial />

    <BookShowcase />

    <Reviews />
    <!-- <Newsletter /> -->
  </main>
</Layout>
