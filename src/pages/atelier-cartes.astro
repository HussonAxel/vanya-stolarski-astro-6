---
import { Image } from "astro:assets";
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import SiteAnalytics from "../components/SiteAnalytics.astro";
import { getImageDimensions } from "../lib/image-dimensions";

export const prerender = true;

type Cover = {
  id: string;
  title: string;
  edition: string;
  src: string;
  profile?: string;
  effect?: string;
};

const covers: Cover[] = [
  
  {
    id: "aube-musique",
    title: "Aube · Variation musicale",
    edition: "Filtre Holographique",
    src: "/assets/card-tests/collibris/aube-musique.webp",
    effect: "holo",
  },
  {
    id: "aube-couverture",
    title: "Aube · Première couverture",
    edition: "Filtre Satin",
    src: "/assets/card-tests/collibris/aube-premiere-couverture.webp",
    effect: "satin",
  },
  {
    id: "pumpkin-space",
    title: "Pumpkin Space",
    edition: "Filtre Prismatique",
    src: "/assets/card-tests/collibris/pumpkin-space.webp",
    effect: "prism",
  },
  {
    id: "phenix-003",
    title: "Le Phénix d’espoir",
    edition: "Filtre Projecteur",
    src: "/assets/card-tests/collibris/phenix-003.webp",
    effect: "spot",
  },
  {
    id: "coeur-renard-mockup",
    title: "Cœur de Renard · Renard et Fortune",
    edition: "Filtre Holographique",
    src: "/assets/card-tests/collibris/coeur-de-renard-mockup-2.webp",
    effect: "holo",
  },
  {
    id: "pokebox-199",
    title: "Charizard ex #199",
    edition: "Référence Pokebox · SIR",
    src: "/assets/card-tests/pokebox-sv3-5-199/front.webp",
    profile: "pokebox-sir",
  },
];

const effects = [
  { id: "satin", label: "Satin", description: "Lumière douce" },
  { id: "holo", label: "Holographique", description: "Foil irisé" },
  { id: "prism", label: "Prismatique", description: "Spectre net" },
  { id: "spot", label: "Projecteur", description: "Reflet ciblé" },
  { id: "beui-mesh", label: "Mesh", description: "beUI · Gradient fluide" },
  { id: "beui-mesh-aurora", label: "Mesh — Aurora", description: "beUI · Vert & ultraviolet" },
  { id: "beui-warp", label: "Warp", description: "beUI · Rubans fluides" },
  { id: "beui-voronoi", label: "Voronoï", description: "beUI · Cristaux mobiles" },
  { id: "beui-orbit", label: "Dot Orbit", description: "beUI · Micro-reflets orbitaux" },
  { id: "beui-rays", label: "God Rays", description: "beUI · Rayons polaires" },
  { id: "pokebox-ir", label: "Pokebox IR", description: "Illustration Rare · carte #168" },
  { id: "pokebox-sir", label: "Pokebox SIR", description: "Effet SIR original" },
];

const materialLayers = [
  { id: "silver", label: "Base argentée", description: "Éclaircit les zones du masque", uniform: "uLayerSilver", value: 100 },
  { id: "shine", label: "Reflet spectral", description: "Bandes irisées diagonales", uniform: "uLayerShine", value: 100 },
  { id: "wash", label: "Voile irisé", description: "Couleur douce liée à l’inclinaison", uniform: "uLayerWash", value: 100 },
  { id: "glitter", label: "Paillettes", description: "Trois textures réactives au regard", uniform: "uLayerGlitter", value: 100 },
  { id: "glare", label: "Halo", description: "Point lumineux qui suit le pointeur", uniform: "uLayerGlare", value: 100 },
  { id: "etch", label: "Relief gravé", description: "Éclats guidés par les contours", uniform: "uLayerEtch", value: 100 },
];

const materialControls = [
  { group: "Image", label: "Luminosité de base", uniform: "uSirBaseBrightness", min: 0.7, max: 1.3, step: 0.01, value: 1 },
  { group: "Image", label: "Contraste de base", uniform: "uSirBaseContrast", min: 0.65, max: 1.5, step: 0.01, value: 1 },
  { group: "Reflet", label: "Angle", uniform: "uSirShineAngle", min: 0, max: 360, step: 1, value: 90, suffix: "°" },
  { group: "Reflet", label: "Fréquence", uniform: "uSirShineFrequency", min: 0.25, max: 6, step: 0.05, value: 1 },
  { group: "Reflet", label: "Luminosité", uniform: "uSirShineBrightness", min: -0.3, max: 0.3, step: 0.01, value: 0 },
  { group: "Reflet", label: "Contraste", uniform: "uSirShineContrast", min: 0.5, max: 2.5, step: 0.05, value: 1 },
  { group: "Reflet", label: "Saturation", uniform: "uSirShineSaturation", min: 0, max: 5, step: 0.05, value: 3.25 },
  { group: "Voile", label: "Échelle", uniform: "uSirWashScale", min: 0.2, max: 4, step: 0.05, value: 1.1 },
  { group: "Voile", label: "Réponse à l’inclinaison", uniform: "uSirWashTiltSensitivity", min: 0, max: 6, step: 0.05, value: 2.3 },
  { group: "Voile", label: "Saturation", uniform: "uSirWashSaturation", min: 0, max: 3, step: 0.05, value: 0.8 },
  { group: "Voile", label: "Contraste", uniform: "uSirWashContrast", min: 0.4, max: 1.8, step: 0.05, value: 0.95 },
  { group: "Voile", label: "Opacité", uniform: "uSirWashOpacity", min: 0, max: 1.5, step: 0.05, value: 0.75 },
  { group: "Paillettes", label: "Contraste", uniform: "uSirGlitterContrast", min: 0.5, max: 5, step: 0.05, value: 2.3 },
  { group: "Paillettes", label: "Saturation", uniform: "uSirGlitterSaturation", min: 0, max: 4, step: 0.05, value: 0 },
  { group: "Relief A", label: "Échelle", uniform: "uSirTiltSparkleScale", min: 1, max: 14, step: 0.1, value: 4.5 },
  { group: "Relief A", label: "Intensité", uniform: "uSirTiltSparkleIntensity", min: 0, max: 1.5, step: 0.05, value: 0.4 },
  { group: "Relief A", label: "Sensibilité", uniform: "uSirTiltSparkleTiltSensitivity", min: 0, max: 1, step: 0.01, value: 0.1 },
  { group: "Relief B", label: "Échelle", uniform: "uSirTiltSparkle2Scale", min: 1, max: 14, step: 0.1, value: 6 },
  { group: "Relief B", label: "Intensité", uniform: "uSirTiltSparkle2Intensity", min: 0, max: 1.5, step: 0.05, value: 0.4 },
  { group: "Relief B", label: "Sensibilité", uniform: "uSirTiltSparkle2TiltSensitivity", min: 0, max: 1, step: 0.01, value: 0.05 },
];
const positions: Array<[string, string, number, number]> = [
  ["top-left", "Haut gauche", 0.2, 0.8],
  ["top", "Haut", 0.5, 0.8],
  ["top-right", "Haut droite", 0.8, 0.8],
  ["left", "Gauche", 0.2, 0.5],
  ["center", "Centre", 0.5, 0.5],
  ["right", "Droite", 0.8, 0.5],
  ["bottom-left", "Bas gauche", 0.2, 0.2],
  ["bottom", "Bas", 0.5, 0.2],
  ["bottom-right", "Bas droite", 0.8, 0.2],
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead title="Atelier cartes 3D - Vanya Stolarski" description="Atelier interactif pour tester les matières et effets des cartes de Vanya Stolarski." />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=lune-3" />
  </head>
  <body class="card-lab-body">
    <main class="card-lab-shell">
      <header class="lab-header">
        <a class="brand-link" href="/livres" aria-label="Retour aux livres">
          <span class="brand-monogram">VS</span>
          <span>
            <strong>Vanya Stolarski</strong>
            <small>Atelier de cartes 3D</small>
          </span>
        </a>
        <a class="exit-link" href="/livres">
          <span aria-hidden="true">←</span>
          Retour aux livres
        </a>
      </header>

      <section class="lab-intro" aria-labelledby="lab-title">
        <p class="eyebrow">Laboratoire de matière</p>
        <h1 id="lab-title" tabindex="-1">Composez la lumière.<br />Révélez la couverture.</h1>
        <p class="intro-copy">
          Déplacez la carte, choisissez un effet et placez son point de lumière.
          Chaque réglage agit directement sur la scène Three.js.
        </p>
      </section>

      <div class="lab-intro">
        <button type="button" id="activate-card-workshop" class="exit-link">Activer l’aperçu 3D</button>
        <p id="workshop-load-status" role="status">L’aperçu interactif se charge à votre demande.</p>
      </div>
      <section class="lab-workspace" aria-label="Configurateur de carte 3D" inert>
        <div class="stage-column">
          <div class="stage" id="card-stage">
            <canvas id="card-canvas" aria-label="Aperçu interactif de la carte en trois dimensions"></canvas>

            <div class="stage-topline" aria-live="polite">
              <span>
                <strong id="stage-book-title">{covers[0].title}</strong>
                <small id="stage-book-edition">{covers[0].edition}</small>
              </span>
              <span class="render-state" id="render-state">Préparation de la matière</span>
            </div>

            <div class="stage-help">
              <span>Pointez pour incliner</span>
              <span id="stage-effect-label">Holographique</span>
            </div>

            <div class="stage-error" id="stage-error" role="alert" hidden>
              WebGL n’a pas pu démarrer. Essayez un navigateur récent ou désactivez le mode économie d’énergie.
            </div>
          </div>

          <div class="cover-switcher" aria-label="Choisir une couverture">
            {
              covers.map((cover, index) => (
                <button
                  type="button"
                  class="cover-option"
                  data-cover-src={cover.src}
                  data-cover-profile={cover.profile ?? "book"}
                  data-cover-effect={cover.effect}
                  data-cover-title={cover.title}
                  data-cover-edition={cover.edition}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <Image
                    src={cover.src}
                    alt=""
                    width={getImageDimensions(cover.src).width}
                    height={getImageDimensions(cover.src).height}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <span>
                    <strong>{cover.title}</strong>
                    <small>{cover.edition}</small>
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <aside class="control-panel" aria-label="Réglages des effets">
          <div class="panel-heading">
            <div>
              <p>Réglages</p>
              <h2>Matière active</h2>
            </div>
            <button type="button" class="reset-button" id="reset-controls">Réinitialiser</button>
          </div>

          <fieldset class="control-group">
            <legend>Effet</legend>
            <div class="effect-grid">
              {
                effects.map((effect) => (
                  <button
                    type="button"
                    class="effect-option"
                    data-effect={effect.id}
                    aria-pressed={effect.id === "holo" ? "true" : "false"}
                  >
                    <span class={`effect-swatch effect-swatch--${effect.id}`} aria-hidden="true"></span>
                    <span>
                      <strong>{effect.label}</strong>
                      <small>{effect.description}</small>
                    </span>
                  </button>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="control-group">
            <legend>Position du reflet</legend>
            <div class="position-control">
              <div class="position-grid" aria-label="Placer le point de lumière">
                {
                  positions.map(([id, label, x, y]) => (
                    <button
                      type="button"
                      class="position-option"
                      data-position={id}
                      data-x={x}
                      data-y={y}
                      aria-label={label}
                      aria-pressed={id === "center" ? "true" : "false"}
                    >
                      <span></span>
                    </button>
                  ))
                }
              </div>
              <p>
                Sélectionnez une zone fixe, ou activez le suivi pour déplacer le reflet avec le pointeur.
              </p>
            </div>
          </fieldset>

          <fieldset class="control-group slider-group">
            <legend>Propriétés</legend>

            <label class="range-control">
              <span>Intensité <output id="intensity-output">72%</output></span>
              <input id="intensity" type="range" min="0" max="100" value="72" />
            </label>

            <label class="range-control">
              <span>Inclinaison <output id="tilt-output">14°</output></span>
              <input id="tilt" type="range" min="0" max="24" value="14" />
            </label>

            <label class="range-control">
              <span>Épaisseur <output id="depth-output">18%</output></span>
              <input id="depth" type="range" min="4" max="36" value="18" />
            </label>

            <label class="range-control">
              <span>Diffusion <output id="softness-output">46%</output></span>
              <input id="softness" type="range" min="0" max="100" value="46" />
            </label>
          </fieldset>

          <fieldset class="control-group">
            <legend>Mouvement</legend>
            <div class="toggle-list">
              <label class="toggle-row">
                <span><strong>Suivi du pointeur</strong><small>Le reflet suit la surface</small></span>
                <input id="pointer-follow" type="checkbox" checked />
                <i aria-hidden="true"></i>
              </label>
              <label class="toggle-row">
                <span><strong>Flottement</strong><small>Respiration lente de la carte</small></span>
                <input id="float-motion" type="checkbox" checked />
                <i aria-hidden="true"></i>
              </label>
              <label class="toggle-row">
                <span><strong>Rotation lente</strong><small>Inspection automatique du volume</small></span>
                <input id="auto-rotate" type="checkbox" />
                <i aria-hidden="true"></i>
              </label>
              <label class="toggle-row">
                <span><strong>Ombre portée</strong><small>Ancre la carte dans la scène</small></span>
                <input id="cast-shadow" type="checkbox" checked />
                <i aria-hidden="true"></i>
              </label>
            </div>
          </fieldset>

          <div class="preset-row" aria-label="Préréglages">
            <span>Préréglages</span>
            <div>
              <button type="button" data-preset="velvet">Velours</button>
              <button type="button" data-preset="chrome">Chrome</button>
              <button type="button" data-preset="spectrum">Spectre</button>
            </div>
          </div>
        </aside>
      </section>

      <section class="material-builder" id="material-builder" aria-labelledby="builder-title">
        <header class="builder-header">
          <div>
            <p class="eyebrow">Pokebox Material Builder</p>
            <h2 id="builder-title">Construisez une matière, couche par couche.</h2>
            <p>Les réglages s’appliquent à la carte sélectionnée. L’image originale reste intacte.</p>
          </div>
          <button type="button" class="builder-primary" id="activate-builder">Activer Pokebox</button>
        </header>

        <div class="builder-grid">
          <section class="builder-pane" aria-labelledby="builder-sources-title">
            <div class="builder-pane-heading">
              <span>01</span>
              <div><h3 id="builder-sources-title">Surfaces</h3><p>Définissez où agit la matière.</p></div>
            </div>

            <label class="builder-field">
              <span>Masque holographique</span>
              <select id="material-mask-mode">
                <option value="auto">Automatique · adapté à la carte</option>
                <option value="full">Pleine surface</option>
                <option value="reference">Masque SIR de référence</option>
                <option value="uploaded">Image personnalisée</option>
                <option value="none">Aucun effet</option>
              </select>
            </label>
            <label class="file-field">
              <span>Importer un masque</span>
              <input id="material-mask-file" type="file" accept="image/png,image/jpeg,image/webp" />
              <small>PNG ou WebP en niveaux de gris, même format que la carte.</small>
            </label>

            <label class="builder-field">
              <span>Texture de gravure</span>
              <select id="material-etch-mode">
                <option value="auto">Relief automatique de la carte</option>
                <option value="reference">Gravure SIR de référence</option>
                <option value="uploaded">Image personnalisée</option>
                <option value="none">Sans relief</option>
              </select>
            </label>
            <label class="file-field">
              <span>Importer une gravure</span>
              <input id="material-etch-file" type="file" accept="image/png,image/jpeg,image/webp" />
              <small>Les contours clairs deviennent les zones en relief.</small>
            </label>

            <div class="tint-field">
              <label for="material-tint">Teinte de matière</label>
              <div>
                <input id="material-tint" type="color" value="#fff1d2" />
                <label class="range-control builder-range">
                  <span>Présence <output id="material-tint-strength-output">0%</output></span>
                  <input id="material-tint-strength" type="range" min="0" max="100" value="0" />
                </label>
              </div>
            </div>
          </section>

          <section class="builder-pane" aria-labelledby="builder-layers-title">
            <div class="builder-pane-heading">
              <span>02</span>
              <div><h3 id="builder-layers-title">Couches</h3><p>Activez et dosez chaque famille.</p></div>
            </div>
            <div class="layer-stack">
              {
                materialLayers.map((layer) => (
                  <article class="layer-control" data-layer={layer.id}>
                    <label class="layer-toggle">
                      <input type="checkbox" checked data-layer-enabled={layer.uniform} />
                      <i aria-hidden="true"></i>
                      <span><strong>{layer.label}</strong><small>{layer.description}</small></span>
                    </label>
                    <label class="range-control builder-range">
                      <span>Intensité <output data-layer-output={layer.uniform}>{layer.value}%</output></span>
                      <input type="range" min="0" max="100" value={layer.value} data-layer-uniform={layer.uniform} />
                    </label>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="builder-pane builder-pane--parameters" aria-labelledby="builder-parameters-title">
            <div class="builder-pane-heading">
              <span>03</span>
              <div><h3 id="builder-parameters-title">Paramètres fins</h3><p>Les réglages du shader SIR, sans abstraction.</p></div>
            </div>
            <div class="parameter-folds">
              {
                ["Image", "Reflet", "Voile", "Paillettes", "Relief A", "Relief B"].map((group, index) => (
                  <details class="parameter-fold" open={index === 0}>
                    <summary>{group}<span>{materialControls.filter((control) => control.group === group).length}</span></summary>
                    <div>
                      {materialControls.filter((control) => control.group === group).map((control) => (
                        <label class="range-control builder-range">
                          <span>{control.label}<output data-material-output={control.uniform}>{control.value}{control.suffix ?? ""}</output></span>
                          <input
                            type="range"
                            min={control.min}
                            max={control.max}
                            step={control.step}
                            value={control.value}
                            data-material-uniform={control.uniform}
                            data-suffix={control.suffix ?? ""}
                          />
                        </label>
                      ))}
                    </div>
                  </details>
                ))
              }
            </div>
          </section>

          <section class="builder-pane builder-pane--presets" aria-labelledby="builder-presets-title">
            <div class="builder-pane-heading">
              <span>04</span>
              <div><h3 id="builder-presets-title">Presets JSON</h3><p>Conservez, partagez et rechargez une matière.</p></div>
            </div>
            <div class="material-presets" aria-label="Presets de départ">
              <button type="button" data-material-preset="nacre">Nacre</button>
              <button type="button" data-material-preset="argent">Argent gravé</button>
              <button type="button" data-material-preset="dore">Dorure</button>
              <button type="button" data-material-preset="cosmique">Cosmique</button>
            </div>
            <label class="builder-field">
              <span>Preset enregistré</span>
              <select id="saved-material-presets"><option value="">Choisir un preset local</option></select>
            </label>
            <label class="builder-field">
              <span>Nom du preset</span>
              <input id="material-preset-name" type="text" value="Ma matière" maxlength="64" />
            </label>
            <div class="builder-actions">
              <button type="button" id="save-material-preset">Enregistrer</button>
              <button type="button" id="download-material-preset">Télécharger JSON</button>
              <label class="button-file">Importer JSON<input id="import-material-preset" type="file" accept="application/json,.json" /></label>
            </div>
            <label class="builder-field builder-json-field">
              <span>Configuration JSON</span>
              <textarea id="material-preset-json" rows="9" spellcheck="false" aria-label="Configuration JSON du matériau"></textarea>
            </label>
            <button type="button" class="builder-secondary" id="apply-material-json">Appliquer ce JSON</button>
            <p class="builder-status" id="builder-status" aria-live="polite">Le builder est prêt.</p>
          </section>
        </div>
      </section>

      <section class="comparison-panel" aria-labelledby="comparison-title">
        <header class="comparison-header">
          <div>
            <p class="eyebrow">Comparateur</p>
            <h2 id="comparison-title">Deux variantes, un même cadrage.</h2>
            <p>Réglez une matière, capturez-la dans A ou B, puis modifiez les paramètres.</p>
          </div>
          <div class="comparison-actions">
            <button type="button" data-capture-slot="a">Capturer A</button>
            <button type="button" data-capture-slot="b">Capturer B</button>
            <button type="button" id="clear-comparison">Effacer</button>
          </div>
        </header>
        <div class="comparison-grid">
          <figure class="comparison-card" data-comparison="a">
            <div class="comparison-placeholder"><span>A</span><p>Capturez votre première variante</p></div>
            <Image
              src={covers[0].src}
              alt="Variante A de la matière"
              width={getImageDimensions(covers[0].src).width}
              height={getImageDimensions(covers[0].src).height}
              decoding="async"
              hidden
            />
            <figcaption><strong>Variante A</strong><small>Aucune capture</small></figcaption>
          </figure>
          <figure class="comparison-card" data-comparison="b">
            <div class="comparison-placeholder"><span>B</span><p>Capturez votre seconde variante</p></div>
            <Image
              src={covers[0].src}
              alt="Variante B de la matière"
              width={getImageDimensions(covers[0].src).width}
              height={getImageDimensions(covers[0].src).height}
              decoding="async"
              hidden
            />
            <figcaption><strong>Variante B</strong><small>Aucune capture</small></figcaption>
          </figure>
        </div>
      </section>
    </main>

    <script>
      const activate = document.querySelector<HTMLButtonElement>('#activate-card-workshop');
      const workspace = document.querySelector<HTMLElement>('.lab-workspace');
      activate?.addEventListener('click', async () => {
        activate.disabled = true;
        activate.textContent = 'Chargement de l’aperçu…';
        try {
          const { initializeCardWorkshop } = await import('../lib/card-workshop');
          await initializeCardWorkshop();
          if (workspace) workspace.inert = false;
          const heading = document.querySelector<HTMLElement>('#lab-title');
          heading?.focus();
          activate.hidden = true;
        } catch {
          activate.disabled = false;
          activate.textContent = 'Réessayer l’aperçu 3D';
          const message = document.querySelector<HTMLElement>('#workshop-load-status');
          if (message) message.textContent = 'L’aperçu 3D n’a pas pu démarrer. Vous pouvez réessayer.';
        }
      });
    </script>
    <SiteAnalytics />
  </body>
</html>

