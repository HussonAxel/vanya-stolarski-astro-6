---
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteAnalytics from "../components/SiteAnalytics.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const seo = Astro.props;

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=lune-3" />
    <SeoHead {...seo} />
    <style>
      #site-header-shell {
        backdrop-filter: blur(14px);
        transform-origin: top center;
        transition: transform 180ms ease-out;
      }
      body.site-header-docked #site-header-shell { transform: translateY(-4px); }
      @media (prefers-reduced-motion: reduce) {
        #site-header-shell { transition: none; transform: none !important; }
      }
      .skip-link {
        position: fixed; top: 0.5rem; left: 0.5rem; z-index: 100;
        padding: 0.75rem 1rem; background: #fffafa; color: #3d3834;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }
    </style>
  </head>
  <body class="bg-[#FFFAFA] text-[#3d3834]">
    <a href="#site-content" class="skip-link">Aller au contenu</a>
    <header id="site-header" class="fixed inset-x-0 top-0 z-[60] px-4 py-4">
      <div id="site-header-shell" class="site-shell flex w-full items-center justify-between rounded-lg border border-[#3d3834]/14 bg-[#FFFAFA]/92 px-4 py-3 shadow-[0_18px_50px_-30px_rgba(61,56,52,0.35)] backdrop-blur-md">
        <a href="/" class="inline-flex items-center gap-3 text-[#3d3834]">
          <span id="site-header-badge" class="flex h-12 w-12 items-center justify-center rounded-full bg-[#3d3834] font-serif text-2xl text-[#FFFAFA]">
            VS
          </span>
          <span id="site-header-brand" class="hidden sm:block">
            <span id="site-header-brand-text" class="block font-sans text-[10px] font-bold tracking-[0.28em] uppercase">
              Vanya Stolarski
            </span>
          </span>
        </a>

        <button
          type="button"
          id="site-menu-toggle"
          class="inline-flex h-11 w-11 items-center justify-center rounded-md bg-[#3d3834] text-[#FFFAFA] transition-transform duration-300 hover:scale-[1.03]"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="site-menu-panel"
        >
          <svg
            id="site-menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg>
          <svg
            id="site-menu-icon-close"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
    </header>

    <div
      id="site-menu-overlay"
      class="pointer-events-none fixed inset-0 z-40 bg-[#3d3834]/40 opacity-0 transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    <aside
      id="site-menu-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="site-menu-title"
      tabindex="-1"
      inert
      class="pointer-events-none fixed inset-0 z-50 overflow-y-auto opacity-0 transition-opacity duration-300"
      aria-hidden="true"
    >
      <button type="button" id="site-menu-close" class="fixed right-8 top-8 z-10 rounded-md bg-[#3d3834] px-5 py-3 text-[#fffafa]">Fermer le menu</button>
      <Hero />
    </aside>

    <div id="site-content" tabindex="-1">
      <slot />
    </div>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );

      document.querySelectorAll(".fade-up").forEach((el) => observer.observe(el));

      const menuToggle = document.getElementById("site-menu-toggle");
      const menuPanel = document.getElementById("site-menu-panel");
      const menuOverlay = document.getElementById("site-menu-overlay");
      const menuOpenIcon = document.getElementById("site-menu-icon-open");
      const menuCloseIcon = document.getElementById("site-menu-icon-close");
      const menuClose = document.getElementById("site-menu-close");
      const background = document.getElementById("site-content");
      const header = document.getElementById("site-header");
      const menuLinks = Array.from(document.querySelectorAll("#site-menu-panel a"));
      let lastTrigger: HTMLElement | null = null;
      let headerScrollTicking = false;
      const syncHeaderDock = () => {
        document.body.classList.toggle("site-header-docked", window.scrollY > 30);
      };

      const requestHeaderSync = () => {
        if (headerScrollTicking) {
          return;
        }

        headerScrollTicking = true;
        window.requestAnimationFrame(() => {
          syncHeaderDock();
          headerScrollTicking = false;
        });
      };

      const setMenuState = (isOpen: boolean) => {
        if (
          !(menuToggle instanceof HTMLButtonElement) ||
          !(menuPanel instanceof HTMLElement) ||
          !(menuOverlay instanceof HTMLElement)
        ) {
          return;
        }

        menuToggle.setAttribute("aria-expanded", String(isOpen));
        menuToggle.setAttribute(
          "aria-label",
          isOpen ? "Fermer le menu" : "Ouvrir le menu"
        );
        if (!isOpen && menuPanel.contains(document.activeElement)) {
          (lastTrigger ?? menuToggle).focus();
        }
        menuPanel.inert = !isOpen;
        if (background) background.inert = isOpen;
        if (header) header.inert = isOpen;
        if (header) header.style.visibility = isOpen ? "hidden" : "";
        menuPanel.setAttribute("aria-hidden", String(!isOpen));
        menuOverlay.setAttribute("aria-hidden", String(!isOpen));
        menuPanel.classList.toggle("pointer-events-none", !isOpen);
        menuPanel.classList.toggle("opacity-0", !isOpen);
        menuOverlay.classList.toggle("opacity-0", !isOpen);
        menuOverlay.classList.toggle("pointer-events-none", !isOpen);
        document.body.style.overflow = isOpen ? "hidden" : "";

        if (menuOpenIcon instanceof HTMLElement) {
          menuOpenIcon.classList.toggle("hidden", isOpen);
        }

        if (menuCloseIcon instanceof HTMLElement) {
          menuCloseIcon.classList.toggle("hidden", !isOpen);
        }

        if (isOpen && menuClose instanceof HTMLButtonElement) menuClose.focus();

        if (!isOpen && lastTrigger instanceof HTMLElement) {
          lastTrigger.focus();
        }
      };

      if (menuToggle instanceof HTMLButtonElement) {
        menuToggle.addEventListener("click", () => {
          const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
          lastTrigger = menuToggle;
          setMenuState(!isOpen);
        });
      }

      menuClose?.addEventListener("click", () => setMenuState(false));

      if (menuOverlay instanceof HTMLElement) {
        menuOverlay.addEventListener("click", () => setMenuState(false));
      }

      menuLinks.forEach((link) => {
        link.addEventListener("click", () => setMenuState(false));
      });

      document.addEventListener("keydown", (event) => {
        if (menuToggle?.getAttribute("aria-expanded") !== "true") return;
        if (event.key === "Escape") {
          event.preventDefault();
          setMenuState(false);
        }
        if (event.key === "Tab" && menuPanel instanceof HTMLElement) {
          const focusable = [...menuPanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex="0"]')]
            .filter(element => !element.closest('[inert]') && element.getClientRects().length > 0);
          const first = focusable[0], last = focusable.at(-1);
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault(); last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault(); first?.focus();
          }
        }
      });

      window.addEventListener("scroll", requestHeaderSync, { passive: true });
      window.addEventListener("resize", requestHeaderSync, { passive: true });
      syncHeaderDock();
    </script>
    <SiteAnalytics />
  </body>
</html>
